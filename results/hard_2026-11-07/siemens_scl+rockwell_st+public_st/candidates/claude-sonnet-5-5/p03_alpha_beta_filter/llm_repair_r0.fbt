<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FB_AlphaBetaFilter" Comment="Migrated from IEC 61131-3 ST">
  <Identification Standard="61499-2"/>
  <VersionInfo Version="1.0" Author="st2fb" Date="2026-11-06"/>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event"><With Var="measurement"/><With Var="deltaInSecond"/><With Var="alpha"/><With Var="beta"/></Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event"><With Var="output"/></Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="measurement" Type="REAL"/>
      <VarDeclaration Name="deltaInSecond" Type="REAL"/>
      <VarDeclaration Name="alpha" Type="REAL"/>
      <VarDeclaration Name="beta" Type="REAL"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="output" Type="REAL"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="measurementEstimate" Type="REAL" InitialValue="0.0"/>
      <VarDeclaration Name="velocityEstimate" Type="REAL" InitialValue="0.0"/>
      <VarDeclaration Name="predictionError" Type="REAL"/>
      <VarDeclaration Name="measurementIntegrator" Type="REAL"/>
      <VarDeclaration Name="velocityIntegrator" Type="REAL"/>
      <VarDeclaration Name="betaResidualByDelta" Type="REAL"/>
    </InternalVars>
    <ECC>
      <ECState Name="START" x="0" y="0"/>
      <ECState Name="RUN" x="200" y="0">
        <ECAction Algorithm="run" Output="CNF"/>
      </ECState>
      <ECTransition Source="START" Destination="RUN" Condition="REQ" x="100" y="0"/>
      <ECTransition Source="RUN" Destination="START" Condition="1" x="100" y="100"/>
    </ECC>
    <Algorithm Name="run">
      <ST><![CDATA[
measurementIntegrator := measurementEstimate + (velocityEstimate * deltaInSecond);
velocityIntegrator := velocityEstimate;
predictionError := measurement - measurementIntegrator;
measurementIntegrator := measurementIntegrator + (alpha * predictionError);
IF deltaInSecond > 0.0 THEN
  betaResidualByDelta := (beta * predictionError) / deltaInSecond;
ELSE
  betaResidualByDelta := 0.0;
END_IF;
velocityIntegrator := velocityIntegrator + betaResidualByDelta;
measurementEstimate := measurementIntegrator;
velocityEstimate := velocityIntegrator;
output := measurementEstimate;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
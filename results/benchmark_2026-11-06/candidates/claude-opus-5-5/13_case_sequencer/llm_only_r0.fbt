<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="CASE_SEQUENCER" Comment="Migrated from IEC 61131-3 ST">
  <Identification Standard="61499-2"/>
  <VersionInfo Version="1.0" Author="st2fb" Date="2026-11-06"/>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event"><With Var="START_PB"/><With Var="ABORT"/><With Var="HOLD"/><With Var="LEVEL_HIGH"/><With Var="LEVEL_LOW"/><With Var="STEP_TIME"/><With Var="SCAN_DT"/></Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event"><With Var="SEQ"/><With Var="FILL_VALVE"/><With Var="MIXER"/><With Var="DRAIN_VALVE"/><With Var="RINSE_VALVE"/><With Var="CYCLES"/></Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="START_PB" Type="BOOL"/>
      <VarDeclaration Name="ABORT" Type="BOOL"/>
      <VarDeclaration Name="HOLD" Type="BOOL"/>
      <VarDeclaration Name="LEVEL_HIGH" Type="BOOL"/>
      <VarDeclaration Name="LEVEL_LOW" Type="BOOL"/>
      <VarDeclaration Name="STEP_TIME" Type="TIME"/>
      <VarDeclaration Name="SCAN_DT" Type="TIME"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="SEQ" Type="INT"/>
      <VarDeclaration Name="FILL_VALVE" Type="BOOL"/>
      <VarDeclaration Name="MIXER" Type="BOOL"/>
      <VarDeclaration Name="DRAIN_VALVE" Type="BOOL"/>
      <VarDeclaration Name="RINSE_VALVE" Type="BOOL"/>
      <VarDeclaration Name="CYCLES" Type="DINT"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="TIMING" Type="BOOL"/>
      <VarDeclaration Name="STEP_TIMER_IN" Type="BOOL"/>
      <VarDeclaration Name="STEP_TIMER_PT" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="STEP_TIMER_Q" Type="BOOL"/>
      <VarDeclaration Name="STEP_TIMER_ET" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="STEP_TIMER_STATE" Type="INT" InitialValue="0"/>
      <VarDeclaration Name="STEP_TIMER_PREV_IN" Type="BOOL"/>
      <VarDeclaration Name="STEP_TIMER_START_TIME" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="ST2FB_NOW" Type="TIME" InitialValue="T#0s"/>
    </InternalVars>
    <ECC>
      <ECState Name="START" x="0" y="0"/>
      <ECState Name="COMMON" x="200" y="0">
        <ECAction Algorithm="common"/>
      </ECState>
      <ECState Name="IDLE" x="400" y="-400">
        <ECAction Algorithm="idle" Output="CNF"/>
      </ECState>
      <ECState Name="FILLING" x="400" y="-300">
        <ECAction Algorithm="filling" Output="CNF"/>
      </ECState>
      <ECState Name="MIXING" x="400" y="-200">
        <ECAction Algorithm="mixing" Output="CNF"/>
      </ECState>
      <ECState Name="DRAINING" x="400" y="-100">
        <ECAction Algorithm="draining" Output="CNF"/>
      </ECState>
      <ECState Name="RINSING" x="400" y="0">
        <ECAction Algorithm="rinsing" Output="CNF"/>
      </ECState>
      <ECState Name="COUNTING" x="400" y="100">
        <ECAction Algorithm="counting" Output="CNF"/>
      </ECState>
      <ECState Name="ABORTED" x="400" y="200">
        <ECAction Algorithm="aborted" Output="CNF"/>
      </ECState>
      <ECState Name="OTHER" x="400" y="300">
        <ECAction Algorithm="other" Output="CNF"/>
      </ECState>
      <ECTransition Source="START" Destination="COMMON" Condition="REQ" x="100" y="0"/>
      <ECTransition Source="COMMON" Destination="IDLE" Condition="[SEQ = 0]" x="300" y="-400"/>
      <ECTransition Source="COMMON" Destination="FILLING" Condition="[SEQ = 1]" x="300" y="-300"/>
      <ECTransition Source="COMMON" Destination="MIXING" Condition="[SEQ = 2]" x="300" y="-200"/>
      <ECTransition Source="COMMON" Destination="DRAINING" Condition="[SEQ = 3]" x="300" y="-100"/>
      <ECTransition Source="COMMON" Destination="RINSING" Condition="[SEQ &gt;= 4 AND SEQ &lt;= 6]" x="300" y="0"/>
      <ECTransition Source="COMMON" Destination="COUNTING" Condition="[SEQ = 7]" x="300" y="100"/>
      <ECTransition Source="COMMON" Destination="ABORTED" Condition="[SEQ = 8]" x="300" y="200"/>
      <ECTransition Source="COMMON" Destination="OTHER" Condition="1" x="300" y="300"/>
      <ECTransition Source="IDLE" Destination="START" Condition="1" x="200" y="-400"/>
      <ECTransition Source="FILLING" Destination="START" Condition="1" x="200" y="-300"/>
      <ECTransition Source="MIXING" Destination="START" Condition="1" x="200" y="-200"/>
      <ECTransition Source="DRAINING" Destination="START" Condition="1" x="200" y="-100"/>
      <ECTransition Source="RINSING" Destination="START" Condition="1" x="200" y="50"/>
      <ECTransition Source="COUNTING" Destination="START" Condition="1" x="200" y="100"/>
      <ECTransition Source="ABORTED" Destination="START" Condition="1" x="200" y="200"/>
      <ECTransition Source="OTHER" Destination="START" Condition="1" x="200" y="300"/>
    </ECC>
    <Algorithm Name="common">
      <ST><![CDATA[
ST2FB_NOW := ST2FB_NOW + SCAN_DT;
IF NOT HOLD THEN
  STEP_TIMER_IN := TIMING;
  STEP_TIMER_PT := STEP_TIME;
  IF (STEP_TIMER_STATE = 0) AND NOT STEP_TIMER_PREV_IN AND STEP_TIMER_IN THEN
    STEP_TIMER_STATE := 1;
    STEP_TIMER_Q := FALSE;
    STEP_TIMER_START_TIME := ST2FB_NOW;
  ELSE
    IF NOT STEP_TIMER_IN THEN
      STEP_TIMER_ET := T#0s;
      STEP_TIMER_Q := FALSE;
      STEP_TIMER_STATE := 0;
    ELSIF STEP_TIMER_STATE = 1 THEN
      IF STEP_TIMER_START_TIME + STEP_TIMER_PT <= ST2FB_NOW THEN
        STEP_TIMER_STATE := 2;
        STEP_TIMER_Q := TRUE;
        STEP_TIMER_ET := STEP_TIMER_PT;
      ELSE
        STEP_TIMER_ET := ST2FB_NOW - STEP_TIMER_START_TIME;
      END_IF;
    END_IF;
  END_IF;
  STEP_TIMER_PREV_IN := STEP_TIMER_IN;
END_IF;
FILL_VALVE := FALSE;
MIXER := FALSE;
DRAIN_VALVE := FALSE;
RINSE_VALVE := FALSE;
IF ABORT THEN
  SEQ := 8;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="idle">
      <ST><![CDATA[
TIMING := FALSE;
IF START_PB THEN
  SEQ := 1;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="filling">
      <ST><![CDATA[
FILL_VALVE := TRUE;
IF LEVEL_HIGH THEN
  SEQ := 2;
  TIMING := TRUE;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="mixing">
      <ST><![CDATA[
MIXER := TRUE;
IF STEP_TIMER_Q THEN
  SEQ := 3;
  TIMING := FALSE;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="draining">
      <ST><![CDATA[
DRAIN_VALVE := TRUE;
IF LEVEL_LOW THEN
  SEQ := 4;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="rinsing">
      <ST><![CDATA[
RINSE_VALVE := TRUE;
IF STEP_TIMER_Q THEN
  SEQ := SEQ + 1;
  TIMING := FALSE;
ELSE
  TIMING := TRUE;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="counting">
      <ST><![CDATA[
CYCLES := CYCLES + 1;
SEQ := 0;
]]></ST>
    </Algorithm>
    <Algorithm Name="aborted">
      <ST><![CDATA[
TIMING := FALSE;
DRAIN_VALVE := TRUE;
IF LEVEL_LOW AND NOT ABORT THEN
  SEQ := 0;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="other">
      <ST><![CDATA[
SEQ := 0;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="MOTOR_START_STOP" Comment="Migrated from IEC 61131-3 ST">
  <Identification Standard="61499-2"/>
  <VersionInfo Version="1.0" Author="st2fb" Date="2026-11-06"/>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event"><With Var="START_PB"/><With Var="STOP_PB"/><With Var="OVERLOAD"/><With Var="RESET_PB"/></Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event"><With Var="RUNNING"/><With Var="TRIPPED"/><With Var="STARTS"/></Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="START_PB" Type="BOOL"/>
      <VarDeclaration Name="STOP_PB" Type="BOOL"/>
      <VarDeclaration Name="OVERLOAD" Type="BOOL"/>
      <VarDeclaration Name="RESET_PB" Type="BOOL"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="RUNNING" Type="BOOL"/>
      <VarDeclaration Name="TRIPPED" Type="BOOL"/>
      <VarDeclaration Name="STARTS" Type="UINT"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="PREV_RUNNING" Type="BOOL" InitialValue="FALSE"/>
    </InternalVars>
    <ECC>
      <ECState Name="START" x="0" y="0"/>
      <ECState Name="RUN" x="200" y="0">
        <ECAction Algorithm="main" Output="CNF"/>
      </ECState>
      <ECTransition Source="START" Destination="RUN" Condition="REQ" x="100" y="0"/>
      <ECTransition Source="RUN" Destination="START" Condition="1" x="100" y="50"/>
    </ECC>
    <Algorithm Name="main">
      <ST><![CDATA[
IF OVERLOAD THEN
  TRIPPED := TRUE;
ELSIF RESET_PB THEN
  TRIPPED := FALSE;
END_IF;
RUNNING := (START_PB OR RUNNING) AND NOT STOP_PB AND NOT TRIPPED;
IF RUNNING AND NOT PREV_RUNNING THEN
  STARTS := STARTS + 1;
END_IF;
PREV_RUNNING := RUNNING;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="PUMP_STATION_SUPERVISOR" Comment="Migrated from IEC 61131-3 ST">
  <Identification Standard="61499-2"/>
  <VersionInfo Version="1.0" Author="st2fb" Date="2026-11-06"/>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event"><With Var="AUTO_MODE"/><With Var="ACK"/><With Var="RAW_LEVEL"/><With Var="STOP_LEVEL"/><With Var="START_LEVEL"/><With Var="LAG_LEVEL"/><With Var="HIGH_LEVEL"/><With Var="FB_1"/><With Var="FB_2"/><With Var="TRIP_1"/><With Var="TRIP_2"/><With Var="FLOW"/><With Var="SCAN_HOURS"/><With Var="PULSE_SIZE"/><With Var="PROOF_TIME"/><With Var="ALARM_DELAY"/><With Var="SCAN_DT"/></Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event"><With Var="STATE_NO"/><With Var="PUMP_1"/><With Var="PUMP_2"/><With Var="LEAD_IS_2"/><With Var="HIGH_ALARM"/><With Var="STATION_FAULT"/><With Var="FILTERED_LEVEL"/><With Var="TOTAL"/><With Var="PULSES"/><With Var="STARTS"/></Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="AUTO_MODE" Type="BOOL"/>
      <VarDeclaration Name="ACK" Type="BOOL"/>
      <VarDeclaration Name="RAW_LEVEL" Type="REAL"/>
      <VarDeclaration Name="STOP_LEVEL" Type="REAL"/>
      <VarDeclaration Name="START_LEVEL" Type="REAL"/>
      <VarDeclaration Name="LAG_LEVEL" Type="REAL"/>
      <VarDeclaration Name="HIGH_LEVEL" Type="REAL"/>
      <VarDeclaration Name="FB_1" Type="BOOL"/>
      <VarDeclaration Name="FB_2" Type="BOOL"/>
      <VarDeclaration Name="TRIP_1" Type="BOOL"/>
      <VarDeclaration Name="TRIP_2" Type="BOOL"/>
      <VarDeclaration Name="FLOW" Type="REAL"/>
      <VarDeclaration Name="SCAN_HOURS" Type="REAL"/>
      <VarDeclaration Name="PULSE_SIZE" Type="REAL"/>
      <VarDeclaration Name="PROOF_TIME" Type="TIME"/>
      <VarDeclaration Name="ALARM_DELAY" Type="TIME"/>
      <VarDeclaration Name="SCAN_DT" Type="TIME"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="STATE_NO" Type="INT"/>
      <VarDeclaration Name="PUMP_1" Type="BOOL"/>
      <VarDeclaration Name="PUMP_2" Type="BOOL"/>
      <VarDeclaration Name="LEAD_IS_2" Type="BOOL"/>
      <VarDeclaration Name="HIGH_ALARM" Type="BOOL"/>
      <VarDeclaration Name="STATION_FAULT" Type="BOOL"/>
      <VarDeclaration Name="FILTERED_LEVEL" Type="REAL"/>
      <VarDeclaration Name="TOTAL" Type="REAL"/>
      <VarDeclaration Name="PULSES" Type="DINT"/>
      <VarDeclaration Name="STARTS" Type="UINT"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="ST2FB_NOW" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="FAILED_1_S1" Type="BOOL"/>
      <VarDeclaration Name="FAILED_1_R" Type="BOOL"/>
      <VarDeclaration Name="FAILED_1_Q1" Type="BOOL"/>
      <VarDeclaration Name="FAILED_2_S1" Type="BOOL"/>
      <VarDeclaration Name="FAILED_2_R" Type="BOOL"/>
      <VarDeclaration Name="FAILED_2_Q1" Type="BOOL"/>
      <VarDeclaration Name="PROOF_TIMER_IN" Type="BOOL"/>
      <VarDeclaration Name="PROOF_TIMER_PT" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="PROOF_TIMER_Q" Type="BOOL"/>
      <VarDeclaration Name="PROOF_TIMER_ET" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="PROOF_TIMER_STATE" Type="INT" InitialValue="0"/>
      <VarDeclaration Name="PROOF_TIMER_PREV_IN" Type="BOOL"/>
      <VarDeclaration Name="PROOF_TIMER_START_TIME" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="ALARM_TIMER_IN" Type="BOOL"/>
      <VarDeclaration Name="ALARM_TIMER_PT" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="ALARM_TIMER_Q" Type="BOOL"/>
      <VarDeclaration Name="ALARM_TIMER_ET" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="ALARM_TIMER_STATE" Type="INT" InitialValue="0"/>
      <VarDeclaration Name="ALARM_TIMER_PREV_IN" Type="BOOL"/>
      <VarDeclaration Name="ALARM_TIMER_START_TIME" Type="TIME" InitialValue="T#0s"/>
      <VarDeclaration Name="ACK_EDGE_CLK" Type="BOOL"/>
      <VarDeclaration Name="ACK_EDGE_Q" Type="BOOL"/>
      <VarDeclaration Name="ACK_EDGE_M" Type="BOOL"/>
      <VarDeclaration Name="PASSES" Type="INT"/>
      <VarDeclaration Name="I" Type="INT"/>
      <VarDeclaration Name="STEP_SIZE" Type="REAL"/>
      <VarDeclaration Name="PENDING" Type="REAL"/>
      <VarDeclaration Name="LEAD_RUNNING_FB" Type="BOOL"/>
      <VarDeclaration Name="LEAD_FAILED" Type="BOOL"/>
      <VarDeclaration Name="LAG_FAILED" Type="BOOL"/>
    </InternalVars>
    <ECC>
      <ECState Name="START" x="0" y="0"/>
      <ECState Name="COMMON" x="200" y="0">
        <ECAction Algorithm="common"/>
      </ECState>
      <ECState Name="S0" x="400" y="-300">
        <ECAction Algorithm="st0"/>
      </ECState>
      <ECState Name="S1" x="400" y="-150">
        <ECAction Algorithm="st1"/>
      </ECState>
      <ECState Name="S2" x="400" y="0">
        <ECAction Algorithm="st2"/>
      </ECState>
      <ECState Name="S3" x="400" y="150">
        <ECAction Algorithm="st3"/>
      </ECState>
      <ECState Name="S4" x="400" y="300">
        <ECAction Algorithm="st4"/>
      </ECState>
      <ECState Name="S5" x="400" y="450">
        <ECAction Algorithm="st5"/>
      </ECState>
      <ECState Name="OTHER" x="400" y="600">
        <ECAction Algorithm="other"/>
      </ECState>
      <ECState Name="POST" x="600" y="0">
        <ECAction Algorithm="post" Output="CNF"/>
      </ECState>
      <ECTransition Source="START" Destination="COMMON" Condition="REQ" x="100" y="0"/>
      <ECTransition Source="COMMON" Destination="S0" Condition="[STATE_NO = 0]" x="300" y="-300"/>
      <ECTransition Source="COMMON" Destination="S1" Condition="[STATE_NO = 1]" x="300" y="-150"/>
      <ECTransition Source="COMMON" Destination="S2" Condition="[STATE_NO = 2]" x="300" y="0"/>
      <ECTransition Source="COMMON" Destination="S3" Condition="[STATE_NO = 3]" x="300" y="150"/>
      <ECTransition Source="COMMON" Destination="S4" Condition="[STATE_NO = 4]" x="300" y="300"/>
      <ECTransition Source="COMMON" Destination="S5" Condition="[STATE_NO = 5]" x="300" y="450"/>
      <ECTransition Source="COMMON" Destination="OTHER" Condition="1" x="300" y="600"/>
      <ECTransition Source="S0" Destination="POST" Condition="1" x="500" y="-300"/>
      <ECTransition Source="S1" Destination="POST" Condition="1" x="500" y="-150"/>
      <ECTransition Source="S2" Destination="POST" Condition="1" x="500" y="0"/>
      <ECTransition Source="S3" Destination="POST" Condition="1" x="500" y="150"/>
      <ECTransition Source="S4" Destination="POST" Condition="1" x="500" y="300"/>
      <ECTransition Source="S5" Destination="POST" Condition="1" x="500" y="450"/>
      <ECTransition Source="OTHER" Destination="POST" Condition="1" x="500" y="600"/>
      <ECTransition Source="POST" Destination="START" Condition="1" x="300" y="-400"/>
    </ECC>
    <Algorithm Name="common">
      <ST><![CDATA[
ST2FB_NOW := ST2FB_NOW + SCAN_DT;

STEP_SIZE := RAW_LEVEL - FILTERED_LEVEL;
IF (STEP_SIZE > 1.0) OR (STEP_SIZE < -1.0) THEN
  PASSES := 4;
ELSE
  PASSES := 1;
END_IF;
FOR I := 1 TO PASSES DO
  FILTERED_LEVEL := FILTERED_LEVEL + 0.25 * (RAW_LEVEL - FILTERED_LEVEL);
END_FOR;

ACK_EDGE_CLK := ACK;
ACK_EDGE_Q := ACK_EDGE_CLK AND NOT ACK_EDGE_M;
ACK_EDGE_M := ACK_EDGE_CLK;

FAILED_1_S1 := TRIP_1 OR (PROOF_TIMER_Q AND NOT LEAD_IS_2);
FAILED_1_R := ACK_EDGE_Q;
FAILED_1_Q1 := FAILED_1_S1 OR (NOT FAILED_1_R AND FAILED_1_Q1);

FAILED_2_S1 := TRIP_2 OR (PROOF_TIMER_Q AND LEAD_IS_2);
FAILED_2_R := ACK_EDGE_Q;
FAILED_2_Q1 := FAILED_2_S1 OR (NOT FAILED_2_R AND FAILED_2_Q1);

IF LEAD_IS_2 THEN
  LEAD_FAILED := FAILED_2_Q1;
  LAG_FAILED := FAILED_1_Q1;
  LEAD_RUNNING_FB := FB_2;
ELSE
  LEAD_FAILED := FAILED_1_Q1;
  LAG_FAILED := FAILED_2_Q1;
  LEAD_RUNNING_FB := FB_1;
END_IF;

IF NOT AUTO_MODE AND STATE_NO <> 5 THEN
  STATE_NO := 0;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="st0">
      <ST><![CDATA[
IF AUTO_MODE THEN
  STATE_NO := 1;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="st1">
      <ST><![CDATA[
IF LEAD_FAILED AND LAG_FAILED THEN
  STATE_NO := 5;
ELSIF LEAD_FAILED THEN
  LEAD_IS_2 := NOT LEAD_IS_2;
ELSIF FILTERED_LEVEL >= START_LEVEL THEN
  STARTS := STARTS + 1;
  STATE_NO := 2;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="st2">
      <ST><![CDATA[
IF LEAD_FAILED THEN
  STATE_NO := 1;
ELSIF LEAD_RUNNING_FB THEN
  STATE_NO := 3;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="st3">
      <ST><![CDATA[
IF LEAD_FAILED THEN
  STATE_NO := 1;
ELSIF FILTERED_LEVEL <= STOP_LEVEL THEN
  LEAD_IS_2 := NOT LEAD_IS_2;
  STATE_NO := 1;
ELSIF (FILTERED_LEVEL >= LAG_LEVEL) AND NOT LAG_FAILED THEN
  STATE_NO := 4;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="st4">
      <ST><![CDATA[
IF LEAD_FAILED THEN
  STATE_NO := 1;
ELSIF LAG_FAILED OR (FILTERED_LEVEL < LAG_LEVEL) THEN
  STATE_NO := 3;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="st5">
      <ST><![CDATA[
IF NOT (LEAD_FAILED OR LAG_FAILED) THEN
  STATE_NO := 0;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="other">
      <ST><![CDATA[
STATE_NO := 0;
]]></ST>
    </Algorithm>
    <Algorithm Name="post">
      <ST><![CDATA[
PROOF_TIMER_IN := (STATE_NO = 2) AND NOT LEAD_RUNNING_FB;
PROOF_TIMER_PT := PROOF_TIME;
IF (PROOF_TIMER_STATE = 0) AND NOT PROOF_TIMER_PREV_IN AND PROOF_TIMER_IN THEN
  PROOF_TIMER_STATE := 1;
  PROOF_TIMER_Q := FALSE;
  PROOF_TIMER_START_TIME := ST2FB_NOW;
ELSE
  IF NOT PROOF_TIMER_IN THEN
    PROOF_TIMER_ET := T#0s;
    PROOF_TIMER_Q := FALSE;
    PROOF_TIMER_STATE := 0;
  ELSIF PROOF_TIMER_STATE = 1 THEN
    IF PROOF_TIMER_START_TIME + PROOF_TIMER_PT <= ST2FB_NOW THEN
      PROOF_TIMER_STATE := 2;
      PROOF_TIMER_Q := TRUE;
      PROOF_TIMER_ET := PROOF_TIMER_PT;
    ELSE
      PROOF_TIMER_ET := ST2FB_NOW - PROOF_TIMER_START_TIME;
    END_IF;
  END_IF;
END_IF;
PROOF_TIMER_PREV_IN := PROOF_TIMER_IN;

STATION_FAULT := STATE_NO = 5;

IF (STATE_NO >= 2) AND (STATE_NO <= 4) THEN
  PUMP_1 := NOT LEAD_IS_2 OR (STATE_NO = 4);
  PUMP_2 := LEAD_IS_2 OR (STATE_NO = 4);
ELSE
  PUMP_1 := FALSE;
  PUMP_2 := FALSE;
END_IF;

ALARM_TIMER_IN := FILTERED_LEVEL >= HIGH_LEVEL;
ALARM_TIMER_PT := ALARM_DELAY;
IF (ALARM_TIMER_STATE = 0) AND NOT ALARM_TIMER_PREV_IN AND ALARM_TIMER_IN THEN
  ALARM_TIMER_STATE := 1;
  ALARM_TIMER_Q := FALSE;
  ALARM_TIMER_START_TIME := ST2FB_NOW;
ELSE
  IF NOT ALARM_TIMER_IN THEN
    ALARM_TIMER_ET := T#0s;
    ALARM_TIMER_Q := FALSE;
    ALARM_TIMER_STATE := 0;
  ELSIF ALARM_TIMER_STATE = 1 THEN
    IF ALARM_TIMER_START_TIME + ALARM_TIMER_PT <= ST2FB_NOW THEN
      ALARM_TIMER_STATE := 2;
      ALARM_TIMER_Q := TRUE;
      ALARM_TIMER_ET := ALARM_TIMER_PT;
    ELSE
      ALARM_TIMER_ET := ST2FB_NOW - ALARM_TIMER_START_TIME;
    END_IF;
  END_IF;
END_IF;
ALARM_TIMER_PREV_IN := ALARM_TIMER_IN;
HIGH_ALARM := ALARM_TIMER_Q;

IF PUMP_1 OR PUMP_2 THEN
  TOTAL := TOTAL + FLOW * SCAN_HOURS;
  PENDING := PENDING + FLOW * SCAN_HOURS;
  WHILE PENDING >= PULSE_SIZE DO
    PENDING := PENDING - PULSE_SIZE;
    PULSES := PULSES + 1;
  END_WHILE;
END_IF;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="SCALE_CLAMP" Comment="Migrated from IEC 61131-3 ST">
  <Identification Standard="61499-2"/>
  <VersionInfo Version="1.0" Author="st2fb" Date="2026-11-06"/>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event"><With Var="RAW"/><With Var="RAW_MIN"/><With Var="RAW_MAX"/><With Var="ENG_MIN"/><With Var="ENG_MAX"/></Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event"><With Var="ENG"/><With Var="UNDER_RANGE"/><With Var="OVER_RANGE"/><With Var="BAD_RANGE"/></Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="RAW" Type="REAL"/>
      <VarDeclaration Name="RAW_MIN" Type="REAL"/>
      <VarDeclaration Name="RAW_MAX" Type="REAL"/>
      <VarDeclaration Name="ENG_MIN" Type="REAL"/>
      <VarDeclaration Name="ENG_MAX" Type="REAL"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="ENG" Type="REAL"/>
      <VarDeclaration Name="UNDER_RANGE" Type="BOOL"/>
      <VarDeclaration Name="OVER_RANGE" Type="BOOL"/>
      <VarDeclaration Name="BAD_RANGE" Type="BOOL"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="SPAN" Type="REAL"/>
    </InternalVars>
    <ECC>
      <ECState Name="START" x="0" y="0"/>
      <ECState Name="RUN" x="200" y="0">
        <ECAction Algorithm="run" Output="CNF"/>
      </ECState>
      <ECTransition Source="START" Destination="RUN" Condition="REQ" x="100" y="0"/>
      <ECTransition Source="RUN" Destination="START" Condition="1" x="100" y="100"/>
    </ECC>
    <Algorithm Name="run">
      <ST><![CDATA[
SPAN := RAW_MAX - RAW_MIN;
BAD_RANGE := SPAN <= 0.0;
IF BAD_RANGE THEN
  ENG := ENG_MIN;
  UNDER_RANGE := FALSE;
  OVER_RANGE := FALSE;
ELSE
  UNDER_RANGE := RAW < RAW_MIN;
  OVER_RANGE := RAW > RAW_MAX;
  IF UNDER_RANGE THEN
    ENG := ENG_MIN;
  ELSIF OVER_RANGE THEN
    ENG := ENG_MAX;
  ELSE
    ENG := ENG_MIN + (RAW - RAW_MIN) * (ENG_MAX - ENG_MIN) / SPAN;
  END_IF;
END_IF;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
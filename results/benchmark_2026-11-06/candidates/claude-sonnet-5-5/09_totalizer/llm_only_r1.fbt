<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="TOTALIZER" Comment="Migrated from IEC 61131-3 ST">
  <Identification Standard="61499-2"/>
  <VersionInfo Version="1.0" Author="st2fb" Date="2026-11-06"/>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event"><With Var="DP"/><With Var="K_FACTOR"/><With Var="LOW_CUT"/><With Var="SCAN_HOURS"/><With Var="PULSE_SIZE"/><With Var="RESET"/></Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event"><With Var="FLOW"/><With Var="TOTAL"/><With Var="PULSES"/></Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="DP" Type="REAL"/>
      <VarDeclaration Name="K_FACTOR" Type="REAL"/>
      <VarDeclaration Name="LOW_CUT" Type="REAL"/>
      <VarDeclaration Name="SCAN_HOURS" Type="REAL"/>
      <VarDeclaration Name="PULSE_SIZE" Type="REAL"/>
      <VarDeclaration Name="RESET" Type="BOOL"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="FLOW" Type="REAL"/>
      <VarDeclaration Name="TOTAL" Type="REAL"/>
      <VarDeclaration Name="PULSES" Type="DINT"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="ROOT" Type="REAL"/>
      <VarDeclaration Name="PENDING" Type="REAL"/>
      <VarDeclaration Name="I" Type="INT"/>
    </InternalVars>
    <ECC>
      <ECState Name="START" x="0" y="0"/>
      <ECState Name="RUN" x="200" y="0">
        <ECAction Algorithm="run" Output="CNF"/>
      </ECState>
      <ECTransition Source="START" Destination="RUN" Condition="REQ" x="100" y="0"/>
      <ECTransition Source="RUN" Destination="START" Condition="1" x="100" y="100"/>
    </ECC>
    <Algorithm Name="run">
      <ST><![CDATA[
IF DP <= LOW_CUT THEN
  FLOW := 0.0;
ELSE
  ROOT := DP;
  FOR I := 1 TO 8 DO
    ROOT := 0.5 * (ROOT + DP / ROOT);
  END_FOR;
  FLOW := K_FACTOR * ROOT;
END_IF;
IF RESET THEN
  TOTAL := 0.0;
  PENDING := 0.0;
  PULSES := 0;
ELSE
  TOTAL := TOTAL + FLOW * SCAN_HOURS;
  PENDING := PENDING + FLOW * SCAN_HOURS;
  WHILE PENDING >= PULSE_SIZE DO
    PENDING := PENDING - PULSE_SIZE;
    PULSES := PULSES + 1;
  END_WHILE;
END_IF;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
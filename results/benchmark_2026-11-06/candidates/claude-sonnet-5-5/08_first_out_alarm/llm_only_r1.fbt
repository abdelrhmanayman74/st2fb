<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="FIRST_OUT" Comment="Migrated from IEC 61131-3 ST">
  <Identification Standard="61499-2"/>
  <VersionInfo Version="1.0" Author="st2fb" Date="2026-11-06"/>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event"><With Var="TRIP_1"/><With Var="TRIP_2"/><With Var="TRIP_3"/><With Var="TRIP_4"/><With Var="RESET"/></Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event"><With Var="FIRST"/><With Var="ACTIVE"/><With Var="SHUTDOWN"/></Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="TRIP_1" Type="BOOL"/>
      <VarDeclaration Name="TRIP_2" Type="BOOL"/>
      <VarDeclaration Name="TRIP_3" Type="BOOL"/>
      <VarDeclaration Name="TRIP_4" Type="BOOL"/>
      <VarDeclaration Name="RESET" Type="BOOL"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="FIRST" Type="INT"/>
      <VarDeclaration Name="ACTIVE" Type="INT"/>
      <VarDeclaration Name="SHUTDOWN" Type="BOOL"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="START" x="0" y="0"/>
      <ECState Name="RUN" x="200" y="0">
        <ECAction Algorithm="run" Output="CNF"/>
      </ECState>
      <ECTransition Source="START" Destination="RUN" Condition="REQ" x="100" y="0"/>
      <ECTransition Source="RUN" Destination="START" Condition="1" x="100" y="100"/>
    </ECC>
    <Algorithm Name="run">
      <ST><![CDATA[
ACTIVE := 0;
IF TRIP_1 THEN
  ACTIVE := ACTIVE + 1;
END_IF;
IF TRIP_2 THEN
  ACTIVE := ACTIVE + 1;
END_IF;
IF TRIP_3 THEN
  ACTIVE := ACTIVE + 1;
END_IF;
IF TRIP_4 THEN
  ACTIVE := ACTIVE + 1;
END_IF;
IF FIRST = 0 THEN
  IF TRIP_1 THEN
    FIRST := 1;
  ELSIF TRIP_2 THEN
    FIRST := 2;
  ELSIF TRIP_3 THEN
    FIRST := 3;
  ELSIF TRIP_4 THEN
    FIRST := 4;
  END_IF;
ELSIF RESET AND ACTIVE = 0 THEN
  FIRST := 0;
END_IF;
SHUTDOWN := FIRST <> 0;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>
<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="GATE_CYCLE" Comment="Migrated from IEC 61131-3 ST">
  <Identification Standard="61499-2"/>
  <VersionInfo Version="1.0" Author="st2fb" Date="2026-11-06"/>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event"><With Var="OPEN_CMD"/><With Var="AT_TOP"/></Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event"><With Var="SEQ"/><With Var="MOTOR"/><With Var="CYCLES"/></Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="OPEN_CMD" Type="BOOL"/>
      <VarDeclaration Name="AT_TOP" Type="BOOL"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="SEQ" Type="INT"/>
      <VarDeclaration Name="MOTOR" Type="BOOL"/>
      <VarDeclaration Name="CYCLES" Type="INT"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <ECC>
      <ECState Name="START" x="0" y="0"/>
      <ECState Name="IDLE_STEP" x="200" y="0">
        <ECAction Algorithm="idle" Output="CNF"/>
      </ECState>
      <ECState Name="WAIT_RAISING" x="400" y="0"/>
      <ECState Name="RAISING_STEP" x="600" y="0">
        <ECAction Algorithm="raising" Output="CNF"/>
      </ECState>
      <ECState Name="WAIT_DONE" x="800" y="0"/>
      <ECState Name="DONE_STEP" x="1000" y="0">
        <ECAction Algorithm="done" Output="CNF"/>
      </ECState>
      <ECTransition Source="START" Destination="IDLE_STEP" Condition="REQ" x="100" y="0"/>
      <ECTransition Source="IDLE_STEP" Destination="WAIT_RAISING" Condition="[OPEN_CMD]" x="300" y="0"/>
      <ECTransition Source="IDLE_STEP" Destination="START" Condition="1" x="100" y="100"/>
      <ECTransition Source="WAIT_RAISING" Destination="RAISING_STEP" Condition="REQ" x="500" y="0"/>
      <ECTransition Source="RAISING_STEP" Destination="WAIT_DONE" Condition="[AT_TOP]" x="700" y="0"/>
      <ECTransition Source="RAISING_STEP" Destination="WAIT_RAISING" Condition="1" x="500" y="100"/>
      <ECTransition Source="WAIT_DONE" Destination="DONE_STEP" Condition="REQ" x="900" y="0"/>
      <ECTransition Source="DONE_STEP" Destination="START" Condition="1" x="500" y="200"/>
    </ECC>
    <Algorithm Name="idle">
      <ST><![CDATA[
MOTOR := FALSE;
IF OPEN_CMD THEN
  SEQ := 1;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="raising">
      <ST><![CDATA[
MOTOR := TRUE;
IF AT_TOP THEN
  SEQ := 2;
END_IF;
]]></ST>
    </Algorithm>
    <Algorithm Name="done">
      <ST><![CDATA[
MOTOR := FALSE;
CYCLES := CYCLES + 1;
SEQ := 0;
]]></ST>
    </Algorithm>
  </BasicFB>
</FBType>

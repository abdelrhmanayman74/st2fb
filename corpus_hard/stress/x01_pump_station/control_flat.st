(* Solvability control, never shown to a model: the same behaviour in the translator's v1 subset. It only shows that the
   target can express the program. See README.md. *)
FUNCTION_BLOCK PUMP_STATION
VAR_INPUT
  AUTO : BOOL;
  ESTOP_OK : BOOL;
  SUCTION_OK : BOOL;
  DISCHARGE_HIGH : BOOL;
  RESET : BOOL;
  LEVEL : REAL;
  LEVEL_STOP : REAL;
  LEVEL_1 : REAL;
  LEVEL_2 : REAL;
  LEVEL_3 : REAL;
  FEEDBACK_1, FEEDBACK_2, FEEDBACK_3 : BOOL;
  THERMAL_1, THERMAL_2, THERMAL_3 : BOOL;
  MAINT_1, MAINT_2, MAINT_3 : BOOL;
  PROOF_TIME : TIME;
  RETRY_DELAY : TIME;
  STAGE_DELAY : TIME;
  ROTATE_TIME : TIME;
  MAX_RETRIES : INT;
END_VAR
VAR_OUTPUT
  RUN_1, RUN_2, RUN_3 : BOOL;
  LOCKED_1, LOCKED_2, LOCKED_3 : BOOL;
  RETRIES_1, RETRIES_2, RETRIES_3 : INT;
  TICKS_1, TICKS_2, TICKS_3 : DINT;
  DUTY : INT;
  STAGES : INT;
  UNMET : INT;
  STATION_ALARM : BOOL;
END_VAR
VAR
  STATE_1, STATE_2, STATE_3 : INT;
  PROOF_1, PROOF_2, PROOF_3 : TON;
  HOLD_OFF_1, HOLD_OFF_2, HOLD_OFF_3 : TON;
  AVAIL_1, AVAIL_2, AVAIL_3 : BOOL;
  CALL_1, CALL_2, CALL_3 : BOOL;
  FAILED : BOOL;
  WANTED : INT;
  PERMIT : BOOL;
  STAGE_TIMER : TON;
  ROTATE_TIMER : TON;
  ALARM_LATCH : SR;
  BEST : INT;
  BEST_TICKS : DINT;
  I, CANDIDATE, REMAIN : INT;
  DUTY_AVAIL : BOOL;
  HERE : BOOL;
END_VAR
  PERMIT := ESTOP_OK AND SUCTION_OK AND NOT DISCHARGE_HIGH;

  IF NOT AUTO OR LEVEL <= LEVEL_STOP THEN
    WANTED := 0;
  ELSIF LEVEL >= LEVEL_3 THEN
    WANTED := 3;
  ELSIF LEVEL >= LEVEL_2 THEN
    WANTED := MAX(WANTED, 2);
  ELSIF LEVEL >= LEVEL_1 THEN
    WANTED := MAX(WANTED, 1);
  END_IF;

  STAGE_TIMER(IN := (STAGES < WANTED) AND NOT STAGE_TIMER.Q, PT := STAGE_DELAY);
  IF STAGES > WANTED THEN
    STAGES := WANTED;
  ELSIF STAGE_TIMER.Q THEN
    STAGES := STAGES + 1;
  END_IF;

  ROTATE_TIMER(IN := AUTO AND NOT ROTATE_TIMER.Q, PT := ROTATE_TIME);
  CASE DUTY OF
    2:
      DUTY_AVAIL := AVAIL_2;
    3:
      DUTY_AVAIL := AVAIL_3;
  ELSE
    DUTY_AVAIL := AVAIL_1;
  END_CASE;
  IF ROTATE_TIMER.Q OR (DUTY = 0) OR NOT DUTY_AVAIL THEN
    BEST := 0;
    BEST_TICKS := 2147483647;
    IF AVAIL_1 AND (TICKS_1 < BEST_TICKS) THEN
      BEST := 1;
      BEST_TICKS := TICKS_1;
    END_IF;
    IF AVAIL_2 AND (TICKS_2 < BEST_TICKS) THEN
      BEST := 2;
      BEST_TICKS := TICKS_2;
    END_IF;
    IF AVAIL_3 AND (TICKS_3 < BEST_TICKS) THEN
      BEST := 3;
      BEST_TICKS := TICKS_3;
    END_IF;
    IF BEST <> 0 THEN
      DUTY := BEST;
    END_IF;
  END_IF;

  REMAIN := STAGES;
  CALL_1 := FALSE;
  CALL_2 := FALSE;
  CALL_3 := FALSE;
  FOR I := 0 TO 2 DO
    CANDIDATE := (MAX(DUTY, 1) + I - 1) MOD 3 + 1;
    CASE CANDIDATE OF
      1:
        HERE := AVAIL_1;
      2:
        HERE := AVAIL_2;
    ELSE
      HERE := AVAIL_3;
    END_CASE;
    IF HERE AND (REMAIN > 0) THEN
      CASE CANDIDATE OF
        1:
          CALL_1 := TRUE;
        2:
          CALL_2 := TRUE;
      ELSE
        CALL_3 := TRUE;
      END_CASE;
      REMAIN := REMAIN - 1;
    END_IF;
  END_FOR;
  UNMET := REMAIN;

  (* Pump 1 *)
  IF RESET AND NOT THERMAL_1 THEN
    RETRIES_1 := 0;
    IF STATE_1 = 4 THEN
      STATE_1 := 0;
    END_IF;
  END_IF;
  IF NOT PERMIT AND STATE_1 <> 4 THEN
    STATE_1 := 0;
  END_IF;
  FAILED := FALSE;
  CASE STATE_1 OF
    0:
      IF CALL_1 AND PERMIT AND NOT MAINT_1 AND NOT THERMAL_1 THEN
        STATE_1 := 1;
      END_IF;
    1:
      IF NOT CALL_1 THEN
        STATE_1 := 0;
      ELSIF THERMAL_1 OR PROOF_1.Q THEN
        FAILED := TRUE;
      ELSIF FEEDBACK_1 THEN
        STATE_1 := 2;
      END_IF;
    2:
      IF NOT CALL_1 THEN
        STATE_1 := 0;
      ELSIF THERMAL_1 OR NOT FEEDBACK_1 THEN
        FAILED := TRUE;
      END_IF;
    3:
      IF HOLD_OFF_1.Q THEN
        STATE_1 := 0;
      END_IF;
  END_CASE;
  IF FAILED THEN
    RETRIES_1 := RETRIES_1 + 1;
    IF RETRIES_1 >= MAX_RETRIES THEN
      STATE_1 := 4;
    ELSE
      STATE_1 := 3;
    END_IF;
  END_IF;
  PROOF_1(IN := STATE_1 = 1, PT := PROOF_TIME);
  HOLD_OFF_1(IN := STATE_1 = 3, PT := RETRY_DELAY);
  RUN_1 := (STATE_1 = 1) OR (STATE_1 = 2);
  AVAIL_1 := NOT MAINT_1 AND NOT THERMAL_1 AND (STATE_1 <> 3) AND (STATE_1 <> 4);
  LOCKED_1 := STATE_1 = 4;
  IF STATE_1 = 2 THEN
    TICKS_1 := TICKS_1 + 1;
  END_IF;
  (* Pump 2 *)
  IF RESET AND NOT THERMAL_2 THEN
    RETRIES_2 := 0;
    IF STATE_2 = 4 THEN
      STATE_2 := 0;
    END_IF;
  END_IF;
  IF NOT PERMIT AND STATE_2 <> 4 THEN
    STATE_2 := 0;
  END_IF;
  FAILED := FALSE;
  CASE STATE_2 OF
    0:
      IF CALL_2 AND PERMIT AND NOT MAINT_2 AND NOT THERMAL_2 THEN
        STATE_2 := 1;
      END_IF;
    1:
      IF NOT CALL_2 THEN
        STATE_2 := 0;
      ELSIF THERMAL_2 OR PROOF_2.Q THEN
        FAILED := TRUE;
      ELSIF FEEDBACK_2 THEN
        STATE_2 := 2;
      END_IF;
    2:
      IF NOT CALL_2 THEN
        STATE_2 := 0;
      ELSIF THERMAL_2 OR NOT FEEDBACK_2 THEN
        FAILED := TRUE;
      END_IF;
    3:
      IF HOLD_OFF_2.Q THEN
        STATE_2 := 0;
      END_IF;
  END_CASE;
  IF FAILED THEN
    RETRIES_2 := RETRIES_2 + 1;
    IF RETRIES_2 >= MAX_RETRIES THEN
      STATE_2 := 4;
    ELSE
      STATE_2 := 3;
    END_IF;
  END_IF;
  PROOF_2(IN := STATE_2 = 1, PT := PROOF_TIME);
  HOLD_OFF_2(IN := STATE_2 = 3, PT := RETRY_DELAY);
  RUN_2 := (STATE_2 = 1) OR (STATE_2 = 2);
  AVAIL_2 := NOT MAINT_2 AND NOT THERMAL_2 AND (STATE_2 <> 3) AND (STATE_2 <> 4);
  LOCKED_2 := STATE_2 = 4;
  IF STATE_2 = 2 THEN
    TICKS_2 := TICKS_2 + 1;
  END_IF;
  (* Pump 3 *)
  IF RESET AND NOT THERMAL_3 THEN
    RETRIES_3 := 0;
    IF STATE_3 = 4 THEN
      STATE_3 := 0;
    END_IF;
  END_IF;
  IF NOT PERMIT AND STATE_3 <> 4 THEN
    STATE_3 := 0;
  END_IF;
  FAILED := FALSE;
  CASE STATE_3 OF
    0:
      IF CALL_3 AND PERMIT AND NOT MAINT_3 AND NOT THERMAL_3 THEN
        STATE_3 := 1;
      END_IF;
    1:
      IF NOT CALL_3 THEN
        STATE_3 := 0;
      ELSIF THERMAL_3 OR PROOF_3.Q THEN
        FAILED := TRUE;
      ELSIF FEEDBACK_3 THEN
        STATE_3 := 2;
      END_IF;
    2:
      IF NOT CALL_3 THEN
        STATE_3 := 0;
      ELSIF THERMAL_3 OR NOT FEEDBACK_3 THEN
        FAILED := TRUE;
      END_IF;
    3:
      IF HOLD_OFF_3.Q THEN
        STATE_3 := 0;
      END_IF;
  END_CASE;
  IF FAILED THEN
    RETRIES_3 := RETRIES_3 + 1;
    IF RETRIES_3 >= MAX_RETRIES THEN
      STATE_3 := 4;
    ELSE
      STATE_3 := 3;
    END_IF;
  END_IF;
  PROOF_3(IN := STATE_3 = 1, PT := PROOF_TIME);
  HOLD_OFF_3(IN := STATE_3 = 3, PT := RETRY_DELAY);
  RUN_3 := (STATE_3 = 1) OR (STATE_3 = 2);
  AVAIL_3 := NOT MAINT_3 AND NOT THERMAL_3 AND (STATE_3 <> 3) AND (STATE_3 <> 4);
  LOCKED_3 := STATE_3 = 4;
  IF STATE_3 = 2 THEN
    TICKS_3 := TICKS_3 + 1;
  END_IF;
  ALARM_LATCH(S1 := LOCKED_1 OR LOCKED_2 OR LOCKED_3 OR ((UNMET > 0) AND PERMIT), R := RESET);
  STATION_ALARM := ALARM_LATCH.Q1;
END_FUNCTION_BLOCK

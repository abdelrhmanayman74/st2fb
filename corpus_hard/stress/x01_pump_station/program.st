(* Three-pump station: duty rotation, staged start, fault latching, retries and interlocks. *)
TYPE
  UNIT_VIEW : STRUCT
    AVAILABLE : BOOL;
    TICKS : DINT;
  END_STRUCT;
END_TYPE

(* One pump. STATE: 0 idle, 1 proving feedback, 2 running, 3 waiting to retry, 4 locked out until reset. *)
FUNCTION_BLOCK PUMP_UNIT
VAR_INPUT
  CALL : BOOL;
  PERMIT : BOOL;
  FEEDBACK : BOOL;
  THERMAL : BOOL;
  MAINT : BOOL;
  RESET : BOOL;
  PROOF_TIME : TIME;
  RETRY_DELAY : TIME;
  MAX_RETRIES : INT;
END_VAR
VAR_OUTPUT
  RUN : BOOL;
  AVAILABLE : BOOL;
  LOCKED : BOOL;
  RETRIES : INT;
  TICKS : DINT;
END_VAR
VAR
  STATE : INT;
  PROOF : TON;
  HOLD_OFF : TON;
  FAILED : BOOL;
END_VAR
  IF RESET AND NOT THERMAL THEN
    RETRIES := 0;
    IF STATE = 4 THEN
      STATE := 0;
    END_IF;
  END_IF;
  (* An interlock stops the pump without counting as a failure. *)
  IF NOT PERMIT AND STATE <> 4 THEN
    STATE := 0;
  END_IF;

  FAILED := FALSE;
  CASE STATE OF
    0:
      IF CALL AND PERMIT AND NOT MAINT AND NOT THERMAL THEN
        STATE := 1;
      END_IF;
    1:
      IF NOT CALL THEN
        STATE := 0;
      ELSIF THERMAL OR PROOF.Q THEN
        FAILED := TRUE;
      ELSIF FEEDBACK THEN
        STATE := 2;
      END_IF;
    2:
      IF NOT CALL THEN
        STATE := 0;
      ELSIF THERMAL OR NOT FEEDBACK THEN
        FAILED := TRUE;
      END_IF;
    3:
      IF HOLD_OFF.Q THEN
        STATE := 0;
      END_IF;
  END_CASE;
  IF FAILED THEN
    RETRIES := RETRIES + 1;
    IF RETRIES >= MAX_RETRIES THEN
      STATE := 4;
    ELSE
      STATE := 3;
    END_IF;
  END_IF;

  PROOF(IN := STATE = 1, PT := PROOF_TIME);
  HOLD_OFF(IN := STATE = 3, PT := RETRY_DELAY);
  RUN := (STATE = 1) OR (STATE = 2);
  AVAILABLE := NOT MAINT AND NOT THERMAL AND (STATE <> 3) AND (STATE <> 4);
  LOCKED := STATE = 4;
  IF STATE = 2 THEN
    TICKS := TICKS + 1;
  END_IF;
END_FUNCTION_BLOCK

(* st2fb:dut *)
FUNCTION_BLOCK PUMP_STATION
VAR_INPUT
  AUTO : BOOL;
  ESTOP_OK : BOOL;
  SUCTION_OK : BOOL;
  DISCHARGE_HIGH : BOOL;
  RESET : BOOL;
  LEVEL : REAL;
  LEVEL_STOP : REAL;
  LEVEL_1 : REAL;
  LEVEL_2 : REAL;
  LEVEL_3 : REAL;
  FEEDBACK_1, FEEDBACK_2, FEEDBACK_3 : BOOL;
  THERMAL_1, THERMAL_2, THERMAL_3 : BOOL;
  MAINT_1, MAINT_2, MAINT_3 : BOOL;
  PROOF_TIME : TIME;
  RETRY_DELAY : TIME;
  STAGE_DELAY : TIME;
  ROTATE_TIME : TIME;
  MAX_RETRIES : INT;
END_VAR
VAR_OUTPUT
  RUN_1, RUN_2, RUN_3 : BOOL;
  LOCKED_1, LOCKED_2, LOCKED_3 : BOOL;
  RETRIES_1, RETRIES_2, RETRIES_3 : INT;
  TICKS_1, TICKS_2, TICKS_3 : DINT;
  DUTY : INT;
  STAGES : INT;
  UNMET : INT;
  STATION_ALARM : BOOL;
END_VAR
VAR
  U1, U2, U3 : PUMP_UNIT;
  VIEW : ARRAY[1..3] OF UNIT_VIEW;
  CALLS : ARRAY[1..3] OF BOOL;
  PREFERENCE : ARRAY[1..3] OF INT := [1, 2, 3];
  WANTED : INT;
  PERMIT : BOOL;
  STAGE_TIMER : TON;
  ROTATE_TIMER : TON;
  ALARM_LATCH : SR;
  BEST : INT;
  BEST_TICKS : DINT;
  I, CANDIDATE, REMAIN : INT;
END_VAR
  PERMIT := ESTOP_OK AND SUCTION_OK AND NOT DISCHARGE_HIGH;

  (* Level to wanted stages, with hysteresis below stage 1. *)
  IF NOT AUTO OR LEVEL <= LEVEL_STOP THEN
    WANTED := 0;
  ELSIF LEVEL >= LEVEL_3 THEN
    WANTED := 3;
  ELSIF LEVEL >= LEVEL_2 THEN
    WANTED := MAX(WANTED, 2);
  ELSIF LEVEL >= LEVEL_1 THEN
    WANTED := MAX(WANTED, 1);
  END_IF;

  (* Stages go up one at a time, with a delay between, and drop at once. *)
  STAGE_TIMER(IN := (STAGES < WANTED) AND NOT STAGE_TIMER.Q, PT := STAGE_DELAY);
  IF STAGES > WANTED THEN
    STAGES := WANTED;
  ELSIF STAGE_TIMER.Q THEN
    STAGES := STAGES + 1;
  END_IF;

  (* Duty goes to the available pump with the fewest run ticks, on a rotation or when the duty pump is lost. The search
     starts at a fixed preference order, so a tie goes to the lowest pump number. *)
  ROTATE_TIMER(IN := AUTO AND NOT ROTATE_TIMER.Q, PT := ROTATE_TIME);
  IF ROTATE_TIMER.Q OR (DUTY = 0) OR NOT VIEW[MAX(DUTY, 1)].AVAILABLE THEN
    BEST := 0;
    BEST_TICKS := 2147483647;
    I := 0;
    REPEAT
      I := I + 1;
      CANDIDATE := PREFERENCE[I];
      IF VIEW[CANDIDATE].AVAILABLE AND (VIEW[CANDIDATE].TICKS < BEST_TICKS) THEN
        BEST := CANDIDATE;
        BEST_TICKS := VIEW[CANDIDATE].TICKS;
      END_IF;
    UNTIL I >= 3
    END_REPEAT;
    IF BEST <> 0 THEN
      DUTY := BEST;
    END_IF;
  END_IF;

  (* Calls go to the first available pumps counted from the duty pump. *)
  CALLS[1] := FALSE;
  CALLS[2] := FALSE;
  CALLS[3] := FALSE;
  REMAIN := STAGES;
  FOR I := 0 TO 2 DO
    IF REMAIN = 0 THEN
      EXIT;
    END_IF;
    CANDIDATE := (MAX(DUTY, 1) + I - 1) MOD 3 + 1;
    IF VIEW[CANDIDATE].AVAILABLE THEN
      CALLS[CANDIDATE] := TRUE;
      REMAIN := REMAIN - 1;
    END_IF;
  END_FOR;
  UNMET := REMAIN;

  U1(CALL := CALLS[1], PERMIT := PERMIT, FEEDBACK := FEEDBACK_1, THERMAL := THERMAL_1, MAINT := MAINT_1, RESET := RESET,
     PROOF_TIME := PROOF_TIME, RETRY_DELAY := RETRY_DELAY, MAX_RETRIES := MAX_RETRIES);
  U2(CALL := CALLS[2], PERMIT := PERMIT, FEEDBACK := FEEDBACK_2, THERMAL := THERMAL_2, MAINT := MAINT_2, RESET := RESET,
     PROOF_TIME := PROOF_TIME, RETRY_DELAY := RETRY_DELAY, MAX_RETRIES := MAX_RETRIES);
  U3(CALL := CALLS[3], PERMIT := PERMIT, FEEDBACK := FEEDBACK_3, THERMAL := THERMAL_3, MAINT := MAINT_3, RESET := RESET,
     PROOF_TIME := PROOF_TIME, RETRY_DELAY := RETRY_DELAY, MAX_RETRIES := MAX_RETRIES);

  VIEW[1].AVAILABLE := U1.AVAILABLE;
  VIEW[1].TICKS := U1.TICKS;
  VIEW[2].AVAILABLE := U2.AVAILABLE;
  VIEW[2].TICKS := U2.TICKS;
  VIEW[3].AVAILABLE := U3.AVAILABLE;
  VIEW[3].TICKS := U3.TICKS;

  RUN_1 := U1.RUN;
  RUN_2 := U2.RUN;
  RUN_3 := U3.RUN;
  LOCKED_1 := U1.LOCKED;
  LOCKED_2 := U2.LOCKED;
  LOCKED_3 := U3.LOCKED;
  RETRIES_1 := U1.RETRIES;
  RETRIES_2 := U2.RETRIES;
  RETRIES_3 := U3.RETRIES;
  TICKS_1 := U1.TICKS;
  TICKS_2 := U2.TICKS;
  TICKS_3 := U3.TICKS;

  ALARM_LATCH(S1 := U1.LOCKED OR U2.LOCKED OR U3.LOCKED OR ((UNMET > 0) AND PERMIT), R := RESET);
  STATION_ALARM := ALARM_LATCH.Q1;
END_FUNCTION_BLOCK

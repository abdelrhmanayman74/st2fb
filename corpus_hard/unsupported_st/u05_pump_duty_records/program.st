(* Duty selection over pump records. *)
TYPE
  PUMP_RECORD : STRUCT
    AVAILABLE : BOOL;
    RUNNING : BOOL;
    RUN_TICKS : DINT;
    STARTS : INT;
  END_STRUCT;
END_TYPE

FUNCTION_BLOCK PUMP_DUTY_SELECT
VAR_INPUT
  DEMAND : INT;
  AVAIL_1, AVAIL_2, AVAIL_3 : BOOL;
  RESET_TICKS : BOOL;
END_VAR
VAR_OUTPUT
  RUN_1, RUN_2, RUN_3 : BOOL;
  TICKS_1, TICKS_2, TICKS_3 : DINT;
  STARTS_TOTAL : INT;
  UNMET : INT;
END_VAR
VAR CONSTANT
  PUMP_COUNT : INT := 3;
  WEAR_PER_START : DINT := 5;
END_VAR
VAR
  PUMP : ARRAY[1..3] OF PUMP_RECORD;
  PREV_DEMAND : INT;
  N, P : INT;
  WAS_RUNNING : ARRAY[1..3] OF BOOL;
END_VAR
VAR_TEMP
  BEST : INT;
  BEST_SCORE : DINT;
  SCORE : DINT;
  CHANGED : BOOL;
END_VAR
  PUMP[1].AVAILABLE := AVAIL_1;
  PUMP[2].AVAILABLE := AVAIL_2;
  PUMP[3].AVAILABLE := AVAIL_3;

  (* Reselect when demand changes, or when a running pump has become unavailable. *)
  CHANGED := DEMAND <> PREV_DEMAND;
  FOR P := 1 TO PUMP_COUNT DO
    IF PUMP[P].RUNNING AND NOT PUMP[P].AVAILABLE THEN
      CHANGED := TRUE;
      EXIT;
    END_IF;
  END_FOR;
  PREV_DEMAND := DEMAND;

  IF CHANGED THEN
    FOR P := 1 TO PUMP_COUNT DO
      WAS_RUNNING[P] := PUMP[P].RUNNING;
      PUMP[P].RUNNING := FALSE;
    END_FOR;
    UNMET := 0;
    FOR N := 1 TO DEMAND DO
      BEST := 0;
      BEST_SCORE := 2147483647;
      FOR P := 1 TO PUMP_COUNT DO
        IF PUMP[P].AVAILABLE AND NOT PUMP[P].RUNNING THEN
          SCORE := PUMP[P].RUN_TICKS + WEAR_PER_START * INT_TO_DINT(PUMP[P].STARTS);
          IF SCORE < BEST_SCORE THEN
            BEST := P;
            BEST_SCORE := SCORE;
          END_IF;
        END_IF;
      END_FOR;
      IF BEST = 0 THEN
        UNMET := DEMAND - N + 1;
        EXIT;
      END_IF;
      PUMP[BEST].RUNNING := TRUE;
      IF NOT WAS_RUNNING[BEST] THEN
        PUMP[BEST].STARTS := PUMP[BEST].STARTS + 1;
        STARTS_TOTAL := STARTS_TOTAL + 1;
      END_IF;
    END_FOR;
  END_IF;

  FOR P := 1 TO PUMP_COUNT DO
    IF RESET_TICKS THEN
      PUMP[P].RUN_TICKS := 0;
    ELSIF PUMP[P].RUNNING THEN
      PUMP[P].RUN_TICKS := PUMP[P].RUN_TICKS + 1;
    END_IF;
  END_FOR;

  RUN_1 := PUMP[1].RUNNING;
  RUN_2 := PUMP[2].RUNNING;
  RUN_3 := PUMP[3].RUNNING;
  TICKS_1 := PUMP[1].RUN_TICKS;
  TICKS_2 := PUMP[2].RUN_TICKS;
  TICKS_3 := PUMP[3].RUN_TICKS;
END_FUNCTION_BLOCK

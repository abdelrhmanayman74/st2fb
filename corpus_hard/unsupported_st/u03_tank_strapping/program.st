(* Tank strapping table: level to volume by linear interpolation. *)
TYPE
  STRAP_TABLE : ARRAY[0..5] OF REAL;
END_TYPE

FUNCTION_BLOCK TANK_STRAPPING
VAR_INPUT
  LEVEL_MM : REAL;
  DENSITY : REAL;
  HOLD : BOOL;
END_VAR
VAR_OUTPUT
  VOLUME_L : REAL;
  MASS_KG : DINT;
  SEGMENT : INT;
  OUT_OF_RANGE : BOOL;
END_VAR
VAR
  LEVELS : STRAP_TABLE := [0.0, 200.0, 400.0, 800.0, 1200.0, 2000.0];
  VOLUMES : STRAP_TABLE := [0.0, 150.0, 340.0, 800.0, 1350.0, 2600.0];
  I : INT;
  FRACTION : REAL;
END_VAR
  IF HOLD THEN
    RETURN;
  END_IF;
  OUT_OF_RANGE := (LEVEL_MM < LEVELS[0]) OR (LEVEL_MM > LEVELS[5]);
  I := 0;
  REPEAT
    IF LEVEL_MM <= LEVELS[I + 1] THEN
      EXIT;
    END_IF;
    I := I + 1;
  UNTIL I >= 4
  END_REPEAT;
  SEGMENT := I;
  FRACTION := (LEVEL_MM - LEVELS[I]) / (LEVELS[I + 1] - LEVELS[I]);
  FRACTION := LIMIT(0.0, FRACTION, 1.0);
  VOLUME_L := VOLUMES[I] + FRACTION * (VOLUMES[I + 1] - VOLUMES[I]);
  MASS_KG := REAL_TO_DINT(VOLUME_L * DENSITY);
END_FUNCTION_BLOCK

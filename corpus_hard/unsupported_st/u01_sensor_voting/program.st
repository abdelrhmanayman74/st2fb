(* Two-out-of-three pressure voting. *)
FUNCTION MEDIAN3 : REAL
VAR_INPUT
  A, B, C : REAL;
END_VAR
  MEDIAN3 := MAX(MIN(A, B), MIN(MAX(A, B), C));
END_FUNCTION

FUNCTION OUT_OF_BAND : BOOL
VAR_INPUT
  X, CENTRE, BAND : REAL;
END_VAR
  OUT_OF_BAND := ABS(X - CENTRE) > BAND;
END_FUNCTION

FUNCTION_BLOCK SENSOR_VOTER
VAR_INPUT
  ENABLE : BOOL;
  PT_A, PT_B, PT_C : REAL;
  BAND : REAL;
  HIGH_LIMIT : REAL;
  SPAN : REAL;
  DISAGREE_DELAY : TIME;
  RESET : BOOL;
END_VAR
VAR_OUTPUT
  VOTED : REAL;
  PERCENT : INT;
  BAD_COUNT : INT;
  DISAGREE : BOOL;
  TRIP : BOOL;
END_VAR
VAR
  MIDDLE : REAL;
  DISAGREE_TIMER : TON;
  TRIP_LATCH : RS;
  OVER_HIGH : BOOL;
END_VAR
  IF NOT ENABLE THEN
    DISAGREE_TIMER(IN := FALSE, PT := DISAGREE_DELAY);
    DISAGREE := FALSE;
    BAD_COUNT := 0;
    RETURN;
  END_IF;

  MIDDLE := MEDIAN3(PT_A, PT_B, PT_C);
  BAD_COUNT := 0;
  IF OUT_OF_BAND(PT_A, MIDDLE, BAND) THEN
    BAD_COUNT := BAD_COUNT + 1;
  END_IF;
  IF OUT_OF_BAND(PT_B, MIDDLE, BAND) THEN
    BAD_COUNT := BAD_COUNT + 1;
  END_IF;
  IF OUT_OF_BAND(PT_C, MIDDLE, BAND) THEN
    BAD_COUNT := BAD_COUNT + 1;
  END_IF;

  DISAGREE_TIMER(IN := BAD_COUNT > 0, PT := DISAGREE_DELAY);
  DISAGREE := DISAGREE_TIMER.Q;

  VOTED := MIDDLE;
  PERCENT := REAL_TO_INT(100.0 * VOTED / SPAN);

  OVER_HIGH := (VOTED > HIGH_LIMIT) AND (BAD_COUNT < 2);
  TRIP_LATCH(S := OVER_HIGH, R1 := RESET);
  TRIP := TRIP_LATCH.Q1;
END_FUNCTION_BLOCK

(* Three-valve manifold opened in stages. *)
FUNCTION_BLOCK VALVE_UNIT
VAR_INPUT
  OPEN_CMD : BOOL;
  AT_OPEN : BOOL;
  AT_CLOSED : BOOL;
  RESET : BOOL;
  TRAVEL : TIME;
END_VAR
VAR_OUTPUT
  COIL : BOOL;
  FAULT : BOOL;
  OPENED : BOOL;
END_VAR
VAR
  WATCHDOG : TON;
  LATCH : SR;
END_VAR
  COIL := OPEN_CMD AND NOT FAULT;
  WATCHDOG(IN := (COIL AND NOT AT_OPEN) OR (NOT COIL AND NOT AT_CLOSED AND NOT FAULT), PT := TRAVEL);
  LATCH(S1 := WATCHDOG.Q, R := RESET);
  FAULT := LATCH.Q1;
  OPENED := COIL AND AT_OPEN AND NOT AT_CLOSED;
END_FUNCTION_BLOCK

(* st2fb:dut *)
FUNCTION_BLOCK VALVE_MANIFOLD
VAR_INPUT
  RUN_REQ : BOOL;
  RESET : BOOL;
  AT_OPEN_1, AT_OPEN_2, AT_OPEN_3 : BOOL;
  AT_CLOSED_1, AT_CLOSED_2, AT_CLOSED_3 : BOOL;
  TRAVEL : TIME;
END_VAR
VAR_OUTPUT
  COIL_1, COIL_2, COIL_3 : BOOL;
  ANY_FAULT : BOOL;
  ALL_OPEN : BOOL;
  FAULT_COUNT : INT;
END_VAR
VAR
  V1, V2, V3 : VALVE_UNIT;
END_VAR
  (* Each valve is asked to open only when the one before it has proved open. *)
  V1(OPEN_CMD := RUN_REQ AND NOT ANY_FAULT, AT_OPEN := AT_OPEN_1, AT_CLOSED := AT_CLOSED_1, RESET := RESET, TRAVEL := TRAVEL);
  V2(OPEN_CMD := V1.OPENED, AT_OPEN := AT_OPEN_2, AT_CLOSED := AT_CLOSED_2, RESET := RESET, TRAVEL := TRAVEL);
  V3(OPEN_CMD := V2.OPENED, AT_OPEN := AT_OPEN_3, AT_CLOSED := AT_CLOSED_3, RESET := RESET, TRAVEL := TRAVEL);
  COIL_1 := V1.COIL;
  COIL_2 := V2.COIL;
  COIL_3 := V3.COIL;
  FAULT_COUNT := 0;
  IF V1.FAULT THEN
    FAULT_COUNT := FAULT_COUNT + 1;
  END_IF;
  IF V2.FAULT THEN
    FAULT_COUNT := FAULT_COUNT + 1;
  END_IF;
  IF V3.FAULT THEN
    FAULT_COUNT := FAULT_COUNT + 1;
  END_IF;
  ANY_FAULT := FAULT_COUNT > 0;
  ALL_OPEN := V3.OPENED;
END_FUNCTION_BLOCK

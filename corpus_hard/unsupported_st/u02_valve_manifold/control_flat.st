(* Solvability control, never shown to a model: the same behaviour in the translator's v1 subset. Each instance of
   VALVE_UNIT became its own internal variables and copied statements. *)
FUNCTION_BLOCK VALVE_MANIFOLD
VAR_INPUT
  RUN_REQ : BOOL;
  RESET : BOOL;
  AT_OPEN_1, AT_OPEN_2, AT_OPEN_3 : BOOL;
  AT_CLOSED_1, AT_CLOSED_2, AT_CLOSED_3 : BOOL;
  TRAVEL : TIME;
END_VAR
VAR_OUTPUT
  COIL_1, COIL_2, COIL_3 : BOOL;
  ANY_FAULT : BOOL;
  ALL_OPEN : BOOL;
  FAULT_COUNT : INT;
END_VAR
VAR
  V1_COIL, V1_FAULT, V1_OPENED, V2_COIL, V2_FAULT, V2_OPENED, V3_COIL, V3_FAULT, V3_OPENED : BOOL;
  V1_WATCHDOG, V2_WATCHDOG, V3_WATCHDOG : TON;
  V1_LATCH, V2_LATCH, V3_LATCH : SR;
END_VAR
  (* Instance V1 *)
  V1_COIL := RUN_REQ AND NOT ANY_FAULT AND NOT V1_FAULT;
  V1_WATCHDOG(IN := (V1_COIL AND NOT AT_OPEN_1) OR (NOT V1_COIL AND NOT AT_CLOSED_1 AND NOT V1_FAULT), PT := TRAVEL);
  V1_LATCH(S1 := V1_WATCHDOG.Q, R := RESET);
  V1_FAULT := V1_LATCH.Q1;
  V1_OPENED := V1_COIL AND AT_OPEN_1 AND NOT AT_CLOSED_1;
  (* Instance V2 *)
  V2_COIL := V1_OPENED AND NOT V2_FAULT;
  V2_WATCHDOG(IN := (V2_COIL AND NOT AT_OPEN_2) OR (NOT V2_COIL AND NOT AT_CLOSED_2 AND NOT V2_FAULT), PT := TRAVEL);
  V2_LATCH(S1 := V2_WATCHDOG.Q, R := RESET);
  V2_FAULT := V2_LATCH.Q1;
  V2_OPENED := V2_COIL AND AT_OPEN_2 AND NOT AT_CLOSED_2;
  (* Instance V3 *)
  V3_COIL := V2_OPENED AND NOT V3_FAULT;
  V3_WATCHDOG(IN := (V3_COIL AND NOT AT_OPEN_3) OR (NOT V3_COIL AND NOT AT_CLOSED_3 AND NOT V3_FAULT), PT := TRAVEL);
  V3_LATCH(S1 := V3_WATCHDOG.Q, R := RESET);
  V3_FAULT := V3_LATCH.Q1;
  V3_OPENED := V3_COIL AND AT_OPEN_3 AND NOT AT_CLOSED_3;
  COIL_1 := V1_COIL;
  COIL_2 := V2_COIL;
  COIL_3 := V3_COIL;
  FAULT_COUNT := 0;
  IF V1_FAULT THEN
    FAULT_COUNT := FAULT_COUNT + 1;
  END_IF;
  IF V2_FAULT THEN
    FAULT_COUNT := FAULT_COUNT + 1;
  END_IF;
  IF V3_FAULT THEN
    FAULT_COUNT := FAULT_COUNT + 1;
  END_IF;
  ANY_FAULT := FAULT_COUNT > 0;
  ALL_OPEN := V3_OPENED;
END_FUNCTION_BLOCK

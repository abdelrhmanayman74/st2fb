(* Solvability control, never shown to a model: the same behaviour in the translator's v1 subset. Each nested
   instance became internal variables, and each RETURN became ELSE. *)
FUNCTION_BLOCK CASCADE_CONTROL
VAR_INPUT
  ENABLE : BOOL;
  MASTER_AUTO : BOOL;
  TEMP_SP : REAL;
  TEMP_PV : REAL;
  FLOW_PV : REAL;
  MANUAL_FLOW_SP : REAL;
END_VAR
VAR_OUTPUT
  FLOW_SP : REAL;
  VALVE_PCT : REAL;
  VALVE_RAW : INT;
  WINDUP : BOOL;
END_VAR
VAR
  MASTER_RAMP, MASTER_I_TERM, MASTER_ERROR, MASTER_DEMAND, MASTER_OUTPUT : REAL;
  SLAVE_RAMP, SLAVE_I_TERM, SLAVE_ERROR, SLAVE_DEMAND, SLAVE_OUTPUT : REAL;
  MASTER_SATURATED, SLAVE_SATURATED : BOOL;
END_VAR
  (* MASTER *)
  IF NOT (ENABLE AND MASTER_AUTO) THEN
    MASTER_I_TERM := 0.0;
    MASTER_OUTPUT := 0.0;
    MASTER_SATURATED := FALSE;
  ELSE
    IF (TEMP_SP) > MASTER_RAMP + 2.0 THEN
      MASTER_RAMP := MASTER_RAMP + 2.0;
    ELSIF (TEMP_SP) < MASTER_RAMP - 2.0 THEN
      MASTER_RAMP := MASTER_RAMP - 2.0;
    ELSE
      MASTER_RAMP := TEMP_SP;
    END_IF;
    MASTER_ERROR := MASTER_RAMP - TEMP_PV;
    MASTER_DEMAND := 0.5 * (1.0 + ABS(MASTER_ERROR) ** 0.5) * MASTER_ERROR + MASTER_I_TERM + 0.125 * MASTER_ERROR;
    IF MASTER_DEMAND > 80.0 THEN
      MASTER_OUTPUT := 80.0;
      MASTER_SATURATED := TRUE;
    ELSIF MASTER_DEMAND < 0.0 THEN
      MASTER_OUTPUT := 0.0;
      MASTER_SATURATED := TRUE;
    ELSE
      MASTER_OUTPUT := MASTER_DEMAND;
      MASTER_SATURATED := FALSE;
      MASTER_I_TERM := MASTER_I_TERM + 0.125 * MASTER_ERROR;
    END_IF;
  END_IF;
  IF MASTER_AUTO THEN
    FLOW_SP := MASTER_OUTPUT;
  ELSE
    FLOW_SP := MANUAL_FLOW_SP;
  END_IF;
  (* SLAVE *)
  IF NOT (ENABLE) THEN
    SLAVE_I_TERM := 0.0;
    SLAVE_OUTPUT := 0.0;
    SLAVE_SATURATED := FALSE;
  ELSE
    IF (FLOW_SP) > SLAVE_RAMP + 8.0 THEN
      SLAVE_RAMP := SLAVE_RAMP + 8.0;
    ELSIF (FLOW_SP) < SLAVE_RAMP - 8.0 THEN
      SLAVE_RAMP := SLAVE_RAMP - 8.0;
    ELSE
      SLAVE_RAMP := FLOW_SP;
    END_IF;
    SLAVE_ERROR := SLAVE_RAMP - FLOW_PV;
    SLAVE_DEMAND := 0.25 * (1.0 + ABS(SLAVE_ERROR) ** 0.5) * SLAVE_ERROR + SLAVE_I_TERM + 0.25 * SLAVE_ERROR;
    IF SLAVE_DEMAND > 100.0 THEN
      SLAVE_OUTPUT := 100.0;
      SLAVE_SATURATED := TRUE;
    ELSIF SLAVE_DEMAND < 0.0 THEN
      SLAVE_OUTPUT := 0.0;
      SLAVE_SATURATED := TRUE;
    ELSE
      SLAVE_OUTPUT := SLAVE_DEMAND;
      SLAVE_SATURATED := FALSE;
      SLAVE_I_TERM := SLAVE_I_TERM + 0.25 * SLAVE_ERROR;
    END_IF;
  END_IF;
  VALVE_PCT := SLAVE_OUTPUT;
  VALVE_RAW := REAL_TO_INT(VALVE_PCT * 276.48);
  WINDUP := MASTER_SATURATED OR SLAVE_SATURATED;
END_FUNCTION_BLOCK

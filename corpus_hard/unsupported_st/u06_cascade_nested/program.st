(* Temperature over flow cascade. *)
FUNCTION_BLOCK RATE_LIMIT
VAR_INPUT
  TARGET : REAL;
  MAX_STEP : REAL;
END_VAR
VAR_OUTPUT
  VALUE : REAL;
END_VAR
  IF TARGET > VALUE + MAX_STEP THEN
    VALUE := VALUE + MAX_STEP;
  ELSIF TARGET < VALUE - MAX_STEP THEN
    VALUE := VALUE - MAX_STEP;
  ELSE
    VALUE := TARGET;
  END_IF;
END_FUNCTION_BLOCK

FUNCTION_BLOCK PI_LOOP
VAR_INPUT
  ENABLE : BOOL;
  SP : REAL;
  PV : REAL;
  KP : REAL;
  KI : REAL;
  OUT_MAX : REAL;
  SP_RATE : REAL;
END_VAR
VAR_OUTPUT
  OUTPUT : REAL;
  SATURATED : BOOL;
END_VAR
VAR
  SP_RAMP : RATE_LIMIT;
  I_TERM : REAL;
  ERROR : REAL;
  DEMAND : REAL;
END_VAR
  IF NOT ENABLE THEN
    I_TERM := 0.0;
    OUTPUT := 0.0;
    SATURATED := FALSE;
    RETURN;
  END_IF;
  SP_RAMP(TARGET := SP, MAX_STEP := SP_RATE);
  ERROR := SP_RAMP.VALUE - PV;
  (* The gain grows with the square root of the error. *)
  DEMAND := KP * (1.0 + ABS(ERROR) ** 0.5) * ERROR + I_TERM + KI * ERROR;
  IF DEMAND > OUT_MAX THEN
    OUTPUT := OUT_MAX;
    SATURATED := TRUE;
  ELSIF DEMAND < 0.0 THEN
    OUTPUT := 0.0;
    SATURATED := TRUE;
  ELSE
    OUTPUT := DEMAND;
    SATURATED := FALSE;
    I_TERM := I_TERM + KI * ERROR;
  END_IF;
END_FUNCTION_BLOCK

(* st2fb:dut *)
FUNCTION_BLOCK CASCADE_CONTROL
VAR_INPUT
  ENABLE : BOOL;
  MASTER_AUTO : BOOL;
  TEMP_SP : REAL;
  TEMP_PV : REAL;
  FLOW_PV : REAL;
  MANUAL_FLOW_SP : REAL;
END_VAR
VAR_OUTPUT
  FLOW_SP : REAL;
  VALVE_PCT : REAL;
  VALVE_RAW : INT;
  WINDUP : BOOL;
END_VAR
VAR
  MASTER : PI_LOOP;
  SLAVE : PI_LOOP;
END_VAR
  MASTER(ENABLE := ENABLE AND MASTER_AUTO, SP := TEMP_SP, PV := TEMP_PV, KP := 0.5, KI := 0.125, OUT_MAX := 80.0, SP_RATE := 2.0);
  IF MASTER_AUTO THEN
    FLOW_SP := MASTER.OUTPUT;
  ELSE
    FLOW_SP := MANUAL_FLOW_SP;
  END_IF;
  SLAVE(ENABLE := ENABLE, SP := FLOW_SP, PV := FLOW_PV, KP := 0.25, KI := 0.25, OUT_MAX := 100.0, SP_RATE := 8.0);
  VALVE_PCT := SLAVE.OUTPUT;
  VALVE_RAW := REAL_TO_INT(VALVE_PCT * 276.48);
  WINDUP := MASTER.SATURATED OR SLAVE.SATURATED;
END_FUNCTION_BLOCK

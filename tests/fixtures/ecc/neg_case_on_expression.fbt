<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="F" Comment="Negative C4: a CASE on arithmetic over the position, in an algorithm shared by two control states">
  <InterfaceList>
    <EventInputs><Event Name="REQ" Type="Event"><With Var="GO"/></Event></EventInputs>
    <EventOutputs><Event Name="CNF" Type="Event"><With Var="SEQ"/></Event></EventOutputs>
    <InputVars><VarDeclaration Name="GO" Type="BOOL"/></InputVars>
    <OutputVars><VarDeclaration Name="SEQ" Type="INT"/></OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars></InternalVars>
    <ECC>
      <ECState Name="START"></ECState>
      <ECState Name="SA"><ECAction Algorithm="scan" Output="CNF"/></ECState>
      <ECState Name="PB"></ECState>
      <ECState Name="SB"><ECAction Algorithm="noop"/><ECAction Algorithm="scan" Output="CNF"/></ECState>
      <ECTransition Source="START" Destination="SA" Condition="REQ"/>
      <ECTransition Source="SA" Destination="PB" Condition="1"/>
      <ECTransition Source="PB" Destination="SB" Condition="REQ"/>
      <ECTransition Source="SB" Destination="START" Condition="1"/>
    </ECC>
    <Algorithm Name="scan"><ST><![CDATA[
CASE SEQ + 0 OF
  0:
    IF GO THEN
      SEQ := 1;
    END_IF;
  1:
    SEQ := 2;
  2:
    SEQ := 0;
END_CASE;
]]></ST></Algorithm>
    <Algorithm Name="noop"><ST><![CDATA[
SEQ := SEQ;
]]></ST></Algorithm>
  </BasicFB>
</FBType>

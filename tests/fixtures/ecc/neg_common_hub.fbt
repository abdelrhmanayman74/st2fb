<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="F" Comment="Negative C2: two positions, but every scan goes through one common state and the position is forgotten there">
  <InterfaceList>
    <EventInputs><Event Name="REQ" Type="Event"><With Var="GO"/></Event></EventInputs>
    <EventOutputs><Event Name="CNF" Type="Event"><With Var="SEQ"/></Event></EventOutputs>
    <InputVars><VarDeclaration Name="GO" Type="BOOL"/></InputVars>
    <OutputVars><VarDeclaration Name="SEQ" Type="INT"/></OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars></InternalVars>
    <ECC>
      <ECState Name="START"/>
      <ECState Name="WAIT_B"/>
      <ECState Name="COMMON"><ECAction Algorithm="step_a"/></ECState>
      <ECState Name="A"><ECAction Algorithm="step_b" Output="CNF"/></ECState>
      <ECState Name="B"><ECAction Algorithm="step_c" Output="CNF"/></ECState>
      <ECTransition Source="START" Destination="COMMON" Condition="REQ"/>
      <ECTransition Source="WAIT_B" Destination="COMMON" Condition="REQ"/>
      <ECTransition Source="COMMON" Destination="A" Condition="[GO]"/>
      <ECTransition Source="COMMON" Destination="B" Condition="1"/>
      <ECTransition Source="A" Destination="START" Condition="1"/>
      <ECTransition Source="B" Destination="WAIT_B" Condition="1"/>
    </ECC>
    <Algorithm Name="step_a"><ST><![CDATA[
SEQ := 0;
IF GO THEN
  SEQ := 1;
END_IF;
]]></ST></Algorithm>
    <Algorithm Name="step_b"><ST><![CDATA[
IF NOT GO THEN
  SEQ := 0;
END_IF;
]]></ST></Algorithm>
    <Algorithm Name="step_c"><ST><![CDATA[
SEQ := 2;
]]></ST></Algorithm>
  </BasicFB>
</FBType>

FUNCTION_BLOCK HYST_SM
VAR_INPUT RAW : INT; END_VAR
VAR_OUTPUT PUMP : BOOL; FILTERED : INT; STARTS : INT; END_VAR
  IF PUMP THEN
    IF FILTERED < 5 THEN PUMP := FALSE; END_IF;
  ELSE
    IF FILTERED > 10 THEN PUMP := TRUE; STARTS := STARTS + 1; END_IF;
  END_IF;
  FILTERED := (FILTERED + RAW) / 2;
END_FUNCTION_BLOCK

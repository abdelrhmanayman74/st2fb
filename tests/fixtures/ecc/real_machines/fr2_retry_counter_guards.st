FUNCTION_BLOCK RETRY_SM
VAR_INPUT GO : BOOL; OK : BOOL; RESET : BOOL; END_VAR
VAR_OUTPUT TRYING : BOOL; LOCKED : BOOL; TRIES : INT; END_VAR
VAR POS : INT; END_VAR
  TRYING := FALSE;
  CASE POS OF
    0: TRIES := 0; IF GO THEN POS := 1; END_IF;
    1: TRYING := TRUE;
       IF OK THEN POS := 0;
       ELSIF TRIES = 2 THEN LOCKED := TRUE; POS := 2;
       ELSE TRIES := TRIES + 1; END_IF;
    2: IF RESET THEN LOCKED := FALSE; POS := 0; END_IF;
  END_CASE;
END_FUNCTION_BLOCK

FUNCTION_BLOCK LINEAR_START
VAR_INPUT GO : BOOL; READY : BOOL; END_VAR
VAR_OUTPUT STP : INT; CHARGING : BOOL; RUNNING : BOOL; END_VAR
  CHARGING := FALSE;
  CASE STP OF
    0: IF GO THEN STP := 1; END_IF;
    1: CHARGING := TRUE; IF READY THEN STP := 2; END_IF;
    2: RUNNING := TRUE;
  END_CASE;
END_FUNCTION_BLOCK

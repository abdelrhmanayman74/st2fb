<?xml version="1.0" encoding="UTF-8"?>
<FBType Name="F" Comment="Negative C1: restructured by state count, returns to START every scan and dispatches on SEQ">
  <InterfaceList>
    <EventInputs><Event Name="REQ" Type="Event"><With Var="GO"/></Event></EventInputs>
    <EventOutputs><Event Name="CNF" Type="Event"><With Var="SEQ"/></Event></EventOutputs>
    <InputVars><VarDeclaration Name="GO" Type="BOOL"/></InputVars>
    <OutputVars><VarDeclaration Name="SEQ" Type="INT"/></OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars></InternalVars>
    <ECC>
      <ECState Name="START"/>
      <ECState Name="HUB"><ECAction Algorithm="common"/></ECState>
      <ECState Name="S0"><ECAction Algorithm="step_a" Output="CNF"/></ECState>
      <ECState Name="S1"><ECAction Algorithm="step_b" Output="CNF"/></ECState>
      <ECTransition Source="START" Destination="HUB" Condition="REQ"/>
      <ECTransition Source="HUB" Destination="S0" Condition="[SEQ = 0]"/>
      <ECTransition Source="HUB" Destination="S1" Condition="[SEQ = 1]"/>
      <ECTransition Source="S0" Destination="START" Condition="1"/>
      <ECTransition Source="S1" Destination="START" Condition="1"/>
    </ECC>
    <Algorithm Name="common"><ST><![CDATA[
SEQ := SEQ;
]]></ST></Algorithm>
    <Algorithm Name="step_a"><ST><![CDATA[
SEQ := 0;
IF GO THEN
  SEQ := 1;
END_IF;
]]></ST></Algorithm>
    <Algorithm Name="step_b"><ST><![CDATA[
IF NOT GO THEN
  SEQ := 0;
END_IF;
]]></ST></Algorithm>
  </BasicFB>
</FBType>

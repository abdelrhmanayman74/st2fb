FUNCTION_BLOCK CONVEYOR_INTERLOCK
VAR_INPUT
  START_PB : BOOL;
  STOP_PB : BOOL;
  ESTOP_OK : BOOL;
  JAM_C1 : BOOL;
  JAM_C2 : BOOL;
  JAM_C3 : BOOL;
  STAGGER : TIME;
END_VAR
VAR_OUTPUT
  C1 : BOOL;
  C2 : BOOL;
  C3 : BOOL;
  ALL_RUNNING : BOOL;
END_VAR
VAR
  RUN_REQ : BOOL;
  ON_C2 : TON;
  ON_C1 : TON;
  CLEAR_C2 : TOF;
  CLEAR_C3 : TOF;
  C1_CMD : BOOL;
  C2_CMD : BOOL;
END_VAR
  IF STOP_PB OR NOT ESTOP_OK OR JAM_C1 OR JAM_C2 OR JAM_C3 THEN
    RUN_REQ := FALSE;
  ELSIF START_PB THEN
    RUN_REQ := TRUE;
  END_IF;
  ON_C2(IN := RUN_REQ, PT := STAGGER);
  ON_C1(IN := ON_C2.Q, PT := STAGGER);
  C1_CMD := ON_C1.Q;
  CLEAR_C2(IN := C1_CMD, PT := STAGGER);
  C2_CMD := ON_C2.Q OR CLEAR_C2.Q;
  CLEAR_C3(IN := C2_CMD, PT := STAGGER);
  C1 := C1_CMD AND ESTOP_OK AND NOT JAM_C1 AND NOT JAM_C2 AND NOT JAM_C3;
  C2 := C2_CMD AND ESTOP_OK AND NOT JAM_C2 AND NOT JAM_C3;
  C3 := (RUN_REQ OR CLEAR_C3.Q) AND ESTOP_OK AND NOT JAM_C3;
  ALL_RUNNING := C1 AND C2 AND C3;
END_FUNCTION_BLOCK

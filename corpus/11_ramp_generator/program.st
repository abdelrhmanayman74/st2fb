FUNCTION_BLOCK RAMP_GENERATOR
VAR_INPUT
  SETPOINT : REAL;
  RATE_UP : REAL;
  RATE_DOWN : REAL;
  HOLD : BOOL;
  RESET : BOOL;
  PRESET : REAL;
END_VAR
VAR_OUTPUT
  OUTPUT_VALUE : REAL;
  RAMPING_UP : BOOL;
  RAMPING_DOWN : BOOL;
  AT_SETPOINT : BOOL;
END_VAR
  RAMPING_UP := FALSE;
  RAMPING_DOWN := FALSE;
  IF RESET THEN
    OUTPUT_VALUE := PRESET;
  ELSIF NOT HOLD THEN
    IF OUTPUT_VALUE < SETPOINT THEN
      OUTPUT_VALUE := OUTPUT_VALUE + RATE_UP;
      RAMPING_UP := TRUE;
      IF OUTPUT_VALUE > SETPOINT THEN
        OUTPUT_VALUE := SETPOINT;
      END_IF;
    ELSIF OUTPUT_VALUE > SETPOINT THEN
      OUTPUT_VALUE := OUTPUT_VALUE - RATE_DOWN;
      RAMPING_DOWN := TRUE;
      IF OUTPUT_VALUE < SETPOINT THEN
        OUTPUT_VALUE := SETPOINT;
      END_IF;
    END_IF;
  END_IF;
  AT_SETPOINT := OUTPUT_VALUE = SETPOINT;
END_FUNCTION_BLOCK

FUNCTION_BLOCK FIRST_OUT
VAR_INPUT
  TRIP_1 : BOOL;
  TRIP_2 : BOOL;
  TRIP_3 : BOOL;
  TRIP_4 : BOOL;
  RESET : BOOL;
END_VAR
VAR_OUTPUT
  FIRST : INT;
  ACTIVE : INT;
  SHUTDOWN : BOOL;
END_VAR
  ACTIVE := 0;
  IF TRIP_1 THEN
    ACTIVE := ACTIVE + 1;
  END_IF;
  IF TRIP_2 THEN
    ACTIVE := ACTIVE + 1;
  END_IF;
  IF TRIP_3 THEN
    ACTIVE := ACTIVE + 1;
  END_IF;
  IF TRIP_4 THEN
    ACTIVE := ACTIVE + 1;
  END_IF;
  IF FIRST = 0 THEN
    IF TRIP_1 THEN
      FIRST := 1;
    ELSIF TRIP_2 THEN
      FIRST := 2;
    ELSIF TRIP_3 THEN
      FIRST := 3;
    ELSIF TRIP_4 THEN
      FIRST := 4;
    END_IF;
  ELSIF RESET AND ACTIVE = 0 THEN
    FIRST := 0;
  END_IF;
  SHUTDOWN := FIRST <> 0;
END_FUNCTION_BLOCK

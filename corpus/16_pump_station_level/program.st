FUNCTION_BLOCK PUMP_STATION_LEVEL
VAR_INPUT
  LEVEL : REAL;
  STOP_LEVEL : REAL;
  START_LEVEL : REAL;
  LAG_LEVEL : REAL;
  HIGH_LEVEL : REAL;
  DRY_LEVEL : REAL;
  AUTO_MODE : BOOL;
  LAG_DELAY : TIME;
  ALARM_DELAY : TIME;
END_VAR
VAR_OUTPUT
  PUMP_1 : BOOL;
  PUMP_2 : BOOL;
  LEAD_IS_2 : BOOL;
  HIGH_ALARM : BOOL;
  DRY_TRIP : BOOL;
  CYCLES : DINT;
END_VAR
VAR
  LEAD_REQ : BOOL;
  LAG_REQ : BOOL;
  LAG_TIMER : TON;
  ALARM_TIMER : TON;
  LEAD_STOPPED : F_TRIG;
END_VAR
  DRY_TRIP := LEVEL <= DRY_LEVEL;
  IF NOT AUTO_MODE OR DRY_TRIP OR LEVEL <= STOP_LEVEL THEN
    LEAD_REQ := FALSE;
  ELSIF LEVEL >= START_LEVEL THEN
    LEAD_REQ := TRUE;
  END_IF;
  LAG_TIMER(IN := LEAD_REQ AND LEVEL >= LAG_LEVEL, PT := LAG_DELAY);
  IF NOT LEAD_REQ THEN
    LAG_REQ := FALSE;
  ELSIF LAG_TIMER.Q THEN
    LAG_REQ := TRUE;
  END_IF;
  LEAD_STOPPED(CLK := LEAD_REQ);
  IF LEAD_STOPPED.Q THEN
    LEAD_IS_2 := NOT LEAD_IS_2;
    CYCLES := CYCLES + 1;
  END_IF;
  IF LEAD_IS_2 THEN
    PUMP_2 := LEAD_REQ;
    PUMP_1 := LAG_REQ;
  ELSE
    PUMP_1 := LEAD_REQ;
    PUMP_2 := LAG_REQ;
  END_IF;
  ALARM_TIMER(IN := LEVEL >= HIGH_LEVEL, PT := ALARM_DELAY);
  HIGH_ALARM := ALARM_TIMER.Q;
END_FUNCTION_BLOCK

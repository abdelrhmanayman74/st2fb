FUNCTION_BLOCK MOTOR_START_STOP
VAR_INPUT
  START_PB : BOOL;
  STOP_PB : BOOL;
  OVERLOAD : BOOL;
  RESET_PB : BOOL;
END_VAR
VAR_OUTPUT
  RUNNING : BOOL;
  TRIPPED : BOOL;
  STARTS : UINT;
END_VAR
VAR
  PREV_RUNNING : BOOL;
END_VAR
  IF OVERLOAD THEN
    TRIPPED := TRUE;
  ELSIF RESET_PB THEN
    TRIPPED := FALSE;
  END_IF;
  RUNNING := (START_PB OR RUNNING) AND NOT STOP_PB AND NOT TRIPPED;
  IF RUNNING AND NOT PREV_RUNNING THEN
    STARTS := STARTS + 1;
  END_IF;
  PREV_RUNNING := RUNNING;
END_FUNCTION_BLOCK

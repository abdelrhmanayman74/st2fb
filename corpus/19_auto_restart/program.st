FUNCTION_BLOCK AUTO_RESTART
VAR_INPUT
  RUN_REQ : BOOL;
  DRIVE_FAULT : BOOL;
  OPERATOR_RESET : BOOL;
  RETRY_BUDGET : INT;
  RETRY_DELAY : TIME;
  STABLE_TIME : TIME;
END_VAR
VAR_OUTPUT
  DRIVE_ENABLE : BOOL;
  WAITING : BOOL;
  LOCKED_OUT : BOOL;
  RETRIES_LEFT : INT;
END_VAR
VAR
  FAULT_EDGE : R_TRIG;
  BUDGET : CTD;
  LOCKOUT : RS;
  WAIT_TIMER : TON;
  STABLE_TIMER : TON;
  LOADED : BOOL;
END_VAR
  FAULT_EDGE(CLK := DRIVE_FAULT);
  STABLE_TIMER(IN := DRIVE_ENABLE AND NOT DRIVE_FAULT, PT := STABLE_TIME);
  BUDGET(CD := FAULT_EDGE.Q, LD := NOT LOADED OR OPERATOR_RESET OR STABLE_TIMER.Q, PV := RETRY_BUDGET);
  LOADED := TRUE;
  RETRIES_LEFT := BUDGET.CV;
  LOCKOUT(S := FAULT_EDGE.Q AND BUDGET.Q, R1 := OPERATOR_RESET);
  LOCKED_OUT := LOCKOUT.Q1;
  IF DRIVE_FAULT THEN
    WAITING := TRUE;
  END_IF;
  WAIT_TIMER(IN := WAITING AND NOT DRIVE_FAULT, PT := RETRY_DELAY);
  IF WAIT_TIMER.Q OR NOT RUN_REQ THEN
    WAITING := FALSE;
  END_IF;
  DRIVE_ENABLE := RUN_REQ AND NOT DRIVE_FAULT AND NOT WAITING AND NOT LOCKED_OUT;
END_FUNCTION_BLOCK

FUNCTION_BLOCK PUMP_ROTATION
VAR_INPUT
  REQUIRED : INT;
  AVAIL_1 : BOOL;
  AVAIL_2 : BOOL;
  AVAIL_3 : BOOL;
  RESET_HOURS : BOOL;
  ROTATE_TIME : TIME;
END_VAR
VAR_OUTPUT
  RUN_1 : BOOL;
  RUN_2 : BOOL;
  RUN_3 : BOOL;
  HOURS_1 : DINT;
  HOURS_2 : DINT;
  HOURS_3 : DINT;
  SHORTFALL : INT;
END_VAR
VAR
  ROTATE_TIMER : TON;
  PREV_REQUIRED : INT;
  PREV_AVAIL_1 : BOOL;
  PREV_AVAIL_2 : BOOL;
  PREV_AVAIL_3 : BOOL;
  N : INT;
  P : INT;
  BEST : INT;
  BEST_HOURS : DINT;
  CANDIDATE : BOOL;
  CANDIDATE_HOURS : DINT;
END_VAR
  ROTATE_TIMER(IN := NOT ROTATE_TIMER.Q, PT := ROTATE_TIME);
  IF ROTATE_TIMER.Q OR (REQUIRED <> PREV_REQUIRED)
     OR (AVAIL_1 XOR PREV_AVAIL_1) OR (AVAIL_2 XOR PREV_AVAIL_2) OR (AVAIL_3 XOR PREV_AVAIL_3) THEN
    RUN_1 := FALSE;
    RUN_2 := FALSE;
    RUN_3 := FALSE;
    SHORTFALL := 0;
    FOR N := 1 TO REQUIRED DO
      BEST := 0;
      BEST_HOURS := 2147483647;
      FOR P := 1 TO 3 DO
        CASE P OF
          1:
            CANDIDATE := AVAIL_1 AND NOT RUN_1;
            CANDIDATE_HOURS := HOURS_1;
          2:
            CANDIDATE := AVAIL_2 AND NOT RUN_2;
            CANDIDATE_HOURS := HOURS_2;
          3:
            CANDIDATE := AVAIL_3 AND NOT RUN_3;
            CANDIDATE_HOURS := HOURS_3;
        END_CASE;
        IF CANDIDATE AND CANDIDATE_HOURS < BEST_HOURS THEN
          BEST := P;
          BEST_HOURS := CANDIDATE_HOURS;
        END_IF;
      END_FOR;
      CASE BEST OF
        0:
          SHORTFALL := SHORTFALL + 1;
        1:
          RUN_1 := TRUE;
        2:
          RUN_2 := TRUE;
        3:
          RUN_3 := TRUE;
      END_CASE;
    END_FOR;
  END_IF;
  PREV_REQUIRED := REQUIRED;
  PREV_AVAIL_1 := AVAIL_1;
  PREV_AVAIL_2 := AVAIL_2;
  PREV_AVAIL_3 := AVAIL_3;
  IF RESET_HOURS THEN
    HOURS_1 := 0;
    HOURS_2 := 0;
    HOURS_3 := 0;
  ELSE
    IF RUN_1 THEN
      HOURS_1 := HOURS_1 + 1;
    END_IF;
    IF RUN_2 THEN
      HOURS_2 := HOURS_2 + 1;
    END_IF;
    IF RUN_3 THEN
      HOURS_3 := HOURS_3 + 1;
    END_IF;
  END_IF;
END_FUNCTION_BLOCK

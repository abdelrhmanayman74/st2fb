FUNCTION_BLOCK PUMP_PROTECTION
VAR_INPUT
  RUN_REQ : BOOL;
  SUCTION : REAL;
  DISCHARGE : REAL;
  SUCTION_MIN : REAL;
  DISCHARGE_MAX : REAL;
  RESET : BOOL;
  MAX_STARTS : INT;
  RESET_STARTS : BOOL;
  LOW_DELAY : TIME;
  PRIME_TIME : TIME;
  COOL_TIME : TIME;
END_VAR
VAR_OUTPUT
  PUMP_RUN : BOOL;
  PRIME_VALVE : BOOL;
  COOL_VALVE : BOOL;
  TRIPPED : BOOL;
  STARTS_BLOCKED : BOOL;
  START_COUNT : INT;
  PRIME_ELAPSED : TIME;
END_VAR
VAR
  LOW_TIMER : TON;
  TRIP_LATCH : RS;
  PRIME_PULSE : TP;
  COOL_DOWN : TOF;
  START_COUNTER : CTU;
  RESTART_OK : BOOL;
END_VAR
  LOW_TIMER(IN := PUMP_RUN AND SUCTION < SUCTION_MIN, PT := LOW_DELAY);
  TRIP_LATCH(S := LOW_TIMER.Q OR DISCHARGE > DISCHARGE_MAX, R1 := RESET);
  TRIPPED := TRIP_LATCH.Q1;
  STARTS_BLOCKED := START_COUNTER.Q;
  (* A running pump may keep running; only a new start is subject to cool-down and the start limit. *)
  RESTART_OK := PUMP_RUN OR (NOT COOL_DOWN.Q AND NOT STARTS_BLOCKED);
  PUMP_RUN := RUN_REQ AND NOT TRIPPED AND RESTART_OK;
  START_COUNTER(CU := PUMP_RUN, R := RESET_STARTS, PV := MAX_STARTS);
  START_COUNT := START_COUNTER.CV;
  PRIME_PULSE(IN := PUMP_RUN, PT := PRIME_TIME);
  PRIME_VALVE := PRIME_PULSE.Q;
  PRIME_ELAPSED := PRIME_PULSE.ET;
  COOL_DOWN(IN := PUMP_RUN, PT := COOL_TIME);
  COOL_VALVE := COOL_DOWN.Q;
END_FUNCTION_BLOCK

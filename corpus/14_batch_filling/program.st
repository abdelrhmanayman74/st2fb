FUNCTION_BLOCK BATCH_FILLING
VAR_INPUT
  START_PB : BOOL;
  ABORT : BOOL;
  WEIGHT : REAL;
  TARGET : REAL;
  SLOW_BAND : REAL;
  TOLERANCE : REAL;
  SETTLE_TIME : TIME;
  RESET_COUNT : BOOL;
END_VAR
VAR_OUTPUT
  STATE_NO : INT;
  FAST_VALVE : BOOL;
  SLOW_VALVE : BOOL;
  ACCEPTED : BOOL;
  REJECTED : BOOL;
  BATCH_COUNT : INT;
  NET_WEIGHT : REAL;
END_VAR
VAR
  TARE : REAL;
  SETTLE_TIMER : TON;
  COUNTER : CTU;
  COUNT_PULSE : BOOL;
  START_EDGE : R_TRIG;
END_VAR
  START_EDGE(CLK := START_PB);
  NET_WEIGHT := WEIGHT - TARE;
  FAST_VALVE := FALSE;
  SLOW_VALVE := FALSE;
  COUNT_PULSE := FALSE;
  IF ABORT THEN
    STATE_NO := 0;
    ACCEPTED := FALSE;
    REJECTED := FALSE;
  END_IF;
  CASE STATE_NO OF
    0:
      IF START_EDGE.Q AND NOT ABORT THEN
        TARE := WEIGHT;
        NET_WEIGHT := 0.0;
        ACCEPTED := FALSE;
        REJECTED := FALSE;
        STATE_NO := 1;
      END_IF;
    1:
      FAST_VALVE := TRUE;
      SLOW_VALVE := TRUE;
      IF NET_WEIGHT >= TARGET - SLOW_BAND THEN
        STATE_NO := 2;
      END_IF;
    2:
      SLOW_VALVE := TRUE;
      IF NET_WEIGHT >= TARGET THEN
        STATE_NO := 3;
      END_IF;
    3:
      IF SETTLE_TIMER.Q THEN
        IF (NET_WEIGHT >= TARGET - TOLERANCE) AND (NET_WEIGHT <= TARGET + TOLERANCE) THEN
          ACCEPTED := TRUE;
          COUNT_PULSE := TRUE;
        ELSE
          REJECTED := TRUE;
        END_IF;
        STATE_NO := 4;
      END_IF;
    4:
      IF START_EDGE.Q THEN
        TARE := WEIGHT;
        NET_WEIGHT := 0.0;
        ACCEPTED := FALSE;
        REJECTED := FALSE;
        STATE_NO := 1;
      END_IF;
  END_CASE;
  SETTLE_TIMER(IN := STATE_NO = 3, PT := SETTLE_TIME);
  COUNTER(CU := COUNT_PULSE, R := RESET_COUNT, PV := 1000);
  BATCH_COUNT := COUNTER.CV;
END_FUNCTION_BLOCK

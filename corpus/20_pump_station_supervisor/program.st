FUNCTION_BLOCK PUMP_STATION_SUPERVISOR
VAR_INPUT
  AUTO_MODE : BOOL;
  ACK : BOOL;
  RAW_LEVEL : REAL;
  STOP_LEVEL : REAL;
  START_LEVEL : REAL;
  LAG_LEVEL : REAL;
  HIGH_LEVEL : REAL;
  FB_1 : BOOL;
  FB_2 : BOOL;
  TRIP_1 : BOOL;
  TRIP_2 : BOOL;
  FLOW : REAL;
  SCAN_HOURS : REAL;
  PULSE_SIZE : REAL;
  PROOF_TIME : TIME;
  ALARM_DELAY : TIME;
END_VAR
VAR_OUTPUT
  STATE_NO : INT;
  PUMP_1 : BOOL;
  PUMP_2 : BOOL;
  LEAD_IS_2 : BOOL;
  HIGH_ALARM : BOOL;
  STATION_FAULT : BOOL;
  FILTERED_LEVEL : REAL;
  TOTAL : REAL;
  PULSES : DINT;
  STARTS : UINT;
END_VAR
VAR
  FAILED_1 : SR;
  FAILED_2 : SR;
  PROOF_TIMER : TON;
  ALARM_TIMER : TON;
  ACK_EDGE : R_TRIG;
  PASSES : INT;
  I : INT;
  STEP_SIZE : REAL;
  PENDING : REAL;
  LEAD_RUNNING_FB : BOOL;
  LEAD_FAILED : BOOL;
  LAG_FAILED : BOOL;
END_VAR
  (* Level filter: one pass normally, four when the raw level is far from the filtered value. *)
  STEP_SIZE := RAW_LEVEL - FILTERED_LEVEL;
  IF (STEP_SIZE > 1.0) OR (STEP_SIZE < -1.0) THEN
    PASSES := 4;
  ELSE
    PASSES := 1;
  END_IF;
  FOR I := 1 TO PASSES DO
    FILTERED_LEVEL := FILTERED_LEVEL + 0.25 * (RAW_LEVEL - FILTERED_LEVEL);
  END_FOR;

  ACK_EDGE(CLK := ACK);
  FAILED_1(S1 := TRIP_1 OR (PROOF_TIMER.Q AND NOT LEAD_IS_2), R := ACK_EDGE.Q);
  FAILED_2(S1 := TRIP_2 OR (PROOF_TIMER.Q AND LEAD_IS_2), R := ACK_EDGE.Q);
  IF LEAD_IS_2 THEN
    LEAD_FAILED := FAILED_2.Q1;
    LAG_FAILED := FAILED_1.Q1;
    LEAD_RUNNING_FB := FB_2;
  ELSE
    LEAD_FAILED := FAILED_1.Q1;
    LAG_FAILED := FAILED_2.Q1;
    LEAD_RUNNING_FB := FB_1;
  END_IF;

  IF NOT AUTO_MODE AND STATE_NO <> 5 THEN
    STATE_NO := 0;
  END_IF;
  CASE STATE_NO OF
    0: (* Off *)
      IF AUTO_MODE THEN
        STATE_NO := 1;
      END_IF;
    1: (* Waiting for level *)
      IF LEAD_FAILED AND LAG_FAILED THEN
        STATE_NO := 5;
      ELSIF LEAD_FAILED THEN
        LEAD_IS_2 := NOT LEAD_IS_2;
      ELSIF FILTERED_LEVEL >= START_LEVEL THEN
        STARTS := STARTS + 1;
        STATE_NO := 2;
      END_IF;
    2: (* Lead starting, waiting for proof of running *)
      IF LEAD_FAILED THEN
        STATE_NO := 1;
      ELSIF LEAD_RUNNING_FB THEN
        STATE_NO := 3;
      END_IF;
    3: (* Lead running *)
      IF LEAD_FAILED THEN
        STATE_NO := 1;
      ELSIF FILTERED_LEVEL <= STOP_LEVEL THEN
        LEAD_IS_2 := NOT LEAD_IS_2;
        STATE_NO := 1;
      ELSIF (FILTERED_LEVEL >= LAG_LEVEL) AND NOT LAG_FAILED THEN
        STATE_NO := 4;
      END_IF;
    4: (* Lead and lag running *)
      IF LEAD_FAILED THEN
        STATE_NO := 1;
      ELSIF LAG_FAILED OR (FILTERED_LEVEL < LAG_LEVEL) THEN
        STATE_NO := 3;
      END_IF;
    5: (* Station fault, latched until acknowledged *)
      IF NOT (LEAD_FAILED OR LAG_FAILED) THEN
        STATE_NO := 0;
      END_IF;
  ELSE
    STATE_NO := 0;
  END_CASE;

  PROOF_TIMER(IN := (STATE_NO = 2) AND NOT LEAD_RUNNING_FB, PT := PROOF_TIME);
  STATION_FAULT := STATE_NO = 5;

  IF (STATE_NO >= 2) AND (STATE_NO <= 4) THEN
    PUMP_1 := NOT LEAD_IS_2 OR (STATE_NO = 4);
    PUMP_2 := LEAD_IS_2 OR (STATE_NO = 4);
  ELSE
    PUMP_1 := FALSE;
    PUMP_2 := FALSE;
  END_IF;

  ALARM_TIMER(IN := FILTERED_LEVEL >= HIGH_LEVEL, PT := ALARM_DELAY);
  HIGH_ALARM := ALARM_TIMER.Q;

  IF PUMP_1 OR PUMP_2 THEN
    TOTAL := TOTAL + FLOW * SCAN_HOURS;
    PENDING := PENDING + FLOW * SCAN_HOURS;
    WHILE PENDING >= PULSE_SIZE DO
      PENDING := PENDING - PULSE_SIZE;
      PULSES := PULSES + 1;
    END_WHILE;
  END_IF;
END_FUNCTION_BLOCK

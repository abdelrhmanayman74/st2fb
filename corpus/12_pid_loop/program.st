FUNCTION_BLOCK PID_LOOP
VAR_INPUT
  SP : REAL;
  PV : REAL;
  KP : REAL;
  KI : REAL;
  KD : REAL;
  DEADBAND : REAL;
  OUT_MIN : REAL;
  OUT_MAX : REAL;
  AUTO_MODE : BOOL;
  MANUAL_OUT : REAL;
END_VAR
VAR_OUTPUT
  CV : REAL;
  ERROR_VALUE : REAL;
  SAT_HIGH : BOOL;
  SAT_LOW : BOOL;
END_VAR
VAR
  I_TERM : REAL;
  PREV_PV : REAL;
  UNCLAMPED : REAL;
END_VAR
  ERROR_VALUE := SP - PV;
  IF (ERROR_VALUE < DEADBAND) AND (ERROR_VALUE > 0.0 - DEADBAND) THEN
    ERROR_VALUE := 0.0;
  END_IF;
  IF AUTO_MODE THEN
    IF NOT ((SAT_HIGH AND ERROR_VALUE > 0.0) OR (SAT_LOW AND ERROR_VALUE < 0.0)) THEN
      I_TERM := I_TERM + KI * ERROR_VALUE;
    END_IF;
    UNCLAMPED := KP * ERROR_VALUE + I_TERM - KD * (PV - PREV_PV);
  ELSE
    UNCLAMPED := MANUAL_OUT;
    I_TERM := MANUAL_OUT - KP * ERROR_VALUE;
  END_IF;
  SAT_HIGH := UNCLAMPED >= OUT_MAX;
  SAT_LOW := UNCLAMPED <= OUT_MIN;
  IF SAT_HIGH THEN
    CV := OUT_MAX;
  ELSIF SAT_LOW THEN
    CV := OUT_MIN;
  ELSE
    CV := UNCLAMPED;
  END_IF;
  PREV_PV := PV;
END_FUNCTION_BLOCK

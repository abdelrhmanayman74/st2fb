FUNCTION_BLOCK PARTS_COUNTER
VAR_INPUT
  SENSOR : BOOL;
  RESET : BOOL;
  BATCH_SIZE : INT;
END_VAR
VAR_OUTPUT
  COUNT : INT;
  BATCH_DONE : BOOL;
  BATCHES : DINT;
END_VAR
VAR
  COUNTER : CTU;
  DONE_EDGE : R_TRIG;
END_VAR
  COUNTER(CU := SENSOR, R := RESET OR DONE_EDGE.Q, PV := BATCH_SIZE);
  COUNT := COUNTER.CV;
  BATCH_DONE := COUNTER.Q;
  DONE_EDGE(CLK := COUNTER.Q);
  IF DONE_EDGE.Q THEN
    BATCHES := BATCHES + 1;
  END_IF;
  IF RESET THEN
    BATCHES := 0;
  END_IF;
END_FUNCTION_BLOCK

FUNCTION_BLOCK VALVE_FEEDBACK
VAR_INPUT
  OPEN_CMD : BOOL;
  OPENED_LS : BOOL;
  CLOSED_LS : BOOL;
  RESET : BOOL;
  TRAVEL_LIMIT : TIME;
END_VAR
VAR_OUTPUT
  DRIVE_OPEN : BOOL;
  DRIVE_CLOSE : BOOL;
  IN_POSITION : BOOL;
  FAULT : BOOL;
  TRAVEL_TIME : TIME;
END_VAR
VAR
  OPENING_TIMER : TON;
  CLOSING_TIMER : TON;
END_VAR
  OPENING_TIMER(IN := OPEN_CMD AND NOT OPENED_LS, PT := TRAVEL_LIMIT);
  CLOSING_TIMER(IN := NOT OPEN_CMD AND NOT CLOSED_LS, PT := TRAVEL_LIMIT);
  IF OPENING_TIMER.Q OR CLOSING_TIMER.Q OR (OPENED_LS AND CLOSED_LS) THEN
    FAULT := TRUE;
  ELSIF RESET THEN
    FAULT := FALSE;
  END_IF;
  DRIVE_OPEN := OPEN_CMD AND NOT OPENED_LS AND NOT FAULT;
  DRIVE_CLOSE := NOT OPEN_CMD AND NOT CLOSED_LS AND NOT FAULT;
  IN_POSITION := NOT FAULT AND ((OPEN_CMD AND OPENED_LS) OR (NOT OPEN_CMD AND CLOSED_LS));
  IF OPEN_CMD THEN
    TRAVEL_TIME := OPENING_TIMER.ET;
  ELSE
    TRAVEL_TIME := CLOSING_TIMER.ET;
  END_IF;
END_FUNCTION_BLOCK

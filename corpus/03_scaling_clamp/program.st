FUNCTION_BLOCK SCALE_CLAMP
VAR_INPUT
  RAW : REAL;
  RAW_MIN : REAL;
  RAW_MAX : REAL;
  ENG_MIN : REAL;
  ENG_MAX : REAL;
END_VAR
VAR_OUTPUT
  ENG : REAL;
  UNDER_RANGE : BOOL;
  OVER_RANGE : BOOL;
  BAD_RANGE : BOOL;
END_VAR
VAR
  SPAN : REAL;
END_VAR
  SPAN := RAW_MAX - RAW_MIN;
  BAD_RANGE := SPAN <= 0.0;
  IF BAD_RANGE THEN
    ENG := ENG_MIN;
    UNDER_RANGE := FALSE;
    OVER_RANGE := FALSE;
  ELSE
    UNDER_RANGE := RAW < RAW_MIN;
    OVER_RANGE := RAW > RAW_MAX;
    IF UNDER_RANGE THEN
      ENG := ENG_MIN;
    ELSIF OVER_RANGE THEN
      ENG := ENG_MAX;
    ELSE
      ENG := ENG_MIN + (RAW - RAW_MIN) * (ENG_MAX - ENG_MIN) / SPAN;
    END_IF;
  END_IF;
END_FUNCTION_BLOCK

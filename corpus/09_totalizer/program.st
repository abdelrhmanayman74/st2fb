FUNCTION_BLOCK TOTALIZER
VAR_INPUT
  DP : REAL;
  K_FACTOR : REAL;
  LOW_CUT : REAL;
  SCAN_HOURS : REAL;
  PULSE_SIZE : REAL;
  RESET : BOOL;
END_VAR
VAR_OUTPUT
  FLOW : REAL;
  TOTAL : REAL;
  PULSES : DINT;
END_VAR
VAR
  ROOT : REAL;
  PENDING : REAL;
  I : INT;
END_VAR
  IF DP <= LOW_CUT THEN
    FLOW := 0.0;
  ELSE
    ROOT := DP;
    FOR I := 1 TO 8 DO
      ROOT := 0.5 * (ROOT + DP / ROOT);
    END_FOR;
    FLOW := K_FACTOR * ROOT;
  END_IF;
  IF RESET THEN
    TOTAL := 0.0;
    PENDING := 0.0;
    PULSES := 0;
  ELSE
    TOTAL := TOTAL + FLOW * SCAN_HOURS;
    PENDING := PENDING + FLOW * SCAN_HOURS;
    WHILE PENDING >= PULSE_SIZE DO
      PENDING := PENDING - PULSE_SIZE;
      PULSES := PULSES + 1;
    END_WHILE;
  END_IF;
END_FUNCTION_BLOCK

FUNCTION_BLOCK STAR_DELTA
VAR_INPUT
  START_PB : BOOL;
  STOP_PB : BOOL;
  OVERLOAD : BOOL;
  STAR_TIME : TIME;
END_VAR
VAR_OUTPUT
  K_MAIN : BOOL;
  K_STAR : BOOL;
  K_DELTA : BOOL;
  STAR_ELAPSED : TIME;
END_VAR
VAR
  RUN_CMD : BOOL;
  STAR_TIMER : TON;
  GAP_TIMER : TON;
END_VAR
  RUN_CMD := (START_PB OR RUN_CMD) AND NOT STOP_PB AND NOT OVERLOAD;
  STAR_TIMER(IN := RUN_CMD, PT := STAR_TIME);
  GAP_TIMER(IN := STAR_TIMER.Q, PT := T#50ms);
  K_MAIN := RUN_CMD;
  K_STAR := RUN_CMD AND NOT STAR_TIMER.Q;
  K_DELTA := RUN_CMD AND GAP_TIMER.Q;
  STAR_ELAPSED := STAR_TIMER.ET;
END_FUNCTION_BLOCK

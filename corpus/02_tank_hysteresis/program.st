FUNCTION_BLOCK TANK_HYSTERESIS
VAR_INPUT
  LEVEL : REAL;
  START_LEVEL : REAL;
  STOP_LEVEL : REAL;
  ALARM_MARGIN : REAL;
  ENABLE : BOOL;
END_VAR
VAR_OUTPUT
  INLET_VALVE : BOOL;
  LOW_ALARM : BOOL;
  HIGH_ALARM : BOOL;
END_VAR
  IF NOT ENABLE THEN
    INLET_VALVE := FALSE;
  ELSIF LEVEL <= START_LEVEL THEN
    INLET_VALVE := TRUE;
  ELSIF LEVEL >= STOP_LEVEL THEN
    INLET_VALVE := FALSE;
  END_IF;
  LOW_ALARM := LEVEL < START_LEVEL - ALARM_MARGIN;
  HIGH_ALARM := LEVEL > STOP_LEVEL + ALARM_MARGIN;
END_FUNCTION_BLOCK

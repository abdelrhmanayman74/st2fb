FUNCTION_BLOCK DUTY_STANDBY
VAR_INPUT
  DEMAND : BOOL;
  FB_A : BOOL;
  FB_B : BOOL;
  TRIP_A : BOOL;
  TRIP_B : BOOL;
  RESET : BOOL;
  PROOF_TIME : TIME;
END_VAR
VAR_OUTPUT
  RUN_A : BOOL;
  RUN_B : BOOL;
  LEAD_IS_B : BOOL;
  STANDBY_ACTIVE : BOOL;
  NO_PUMP : BOOL;
  ALTERNATIONS : UINT;
END_VAR
VAR
  DEMAND_END : F_TRIG;
  PROOF_A : TON;
  PROOF_B : TON;
  FAILED_A : SR;
  FAILED_B : SR;
END_VAR
  DEMAND_END(CLK := DEMAND);
  IF DEMAND_END.Q THEN
    LEAD_IS_B := NOT LEAD_IS_B;
    ALTERNATIONS := ALTERNATIONS + 1;
  END_IF;
  PROOF_A(IN := RUN_A AND NOT FB_A, PT := PROOF_TIME);
  PROOF_B(IN := RUN_B AND NOT FB_B, PT := PROOF_TIME);
  FAILED_A(S1 := TRIP_A OR PROOF_A.Q, R := RESET);
  FAILED_B(S1 := TRIP_B OR PROOF_B.Q, R := RESET);
  RUN_A := DEMAND AND NOT FAILED_A.Q1 AND (NOT LEAD_IS_B OR FAILED_B.Q1);
  RUN_B := DEMAND AND NOT FAILED_B.Q1 AND (LEAD_IS_B OR FAILED_A.Q1);
  STANDBY_ACTIVE := (RUN_A AND LEAD_IS_B) OR (RUN_B AND NOT LEAD_IS_B);
  NO_PUMP := DEMAND AND FAILED_A.Q1 AND FAILED_B.Q1;
END_FUNCTION_BLOCK

FUNCTION_BLOCK ALARM_DEBOUNCE
VAR_INPUT
  PROCESS_TRIP : BOOL;
  ACK : BOOL;
  ON_DELAY : TIME;
  OFF_DELAY : TIME;
END_VAR
VAR_OUTPUT
  ALARM : BOOL;
  UNACKED : BOOL;
  HORN : BOOL;
  OCCURRENCES : INT;
END_VAR
VAR
  ON_TIMER : TON;
  OFF_TIMER : TOF;
  RAISED : R_TRIG;
  ACK_EDGE : R_TRIG;
END_VAR
  ON_TIMER(IN := PROCESS_TRIP, PT := ON_DELAY);
  OFF_TIMER(IN := ON_TIMER.Q, PT := OFF_DELAY);
  ALARM := OFF_TIMER.Q;
  RAISED(CLK := ALARM);
  ACK_EDGE(CLK := ACK);
  IF RAISED.Q THEN
    UNACKED := TRUE;
    OCCURRENCES := OCCURRENCES + 1;
  ELSIF ACK_EDGE.Q THEN
    UNACKED := FALSE;
  END_IF;
  HORN := ALARM AND UNACKED;
END_FUNCTION_BLOCK

# Copy of the variable names only. Run `python3 scripts/bootstrap.py` to generate real values into .env,
# which git ignores. Do not put real values in this file.
API_VIEWER_TOKEN=generated-by-bootstrap
API_OPERATOR_TOKEN=generated-by-bootstrap
GATEWAY_TOKEN=generated-by-bootstrap
AGENT_TOKEN=generated-by-bootstrap
MQTT_GATEWAY_PASSWORD=generated-by-bootstrap
MQTT_VIEWER_PASSWORD=generated-by-bootstrap
HOST_UID=1000
HOST_GID=1000

# Optional overrides. All published ports bind to 127.0.0.1 regardless.
# API_PORT=8080
# MQTT_PORT=1883
# OPCUA_PORT=4840
# MODBUS_PORT=1502
# PLANT_SIM_PORT=18100
# IO_SIM_PORT=18101
# CTRL_A_PORT=18111
# CTRL_B_PORT=18112
# CTRL_C_PORT=18113

# Failure-injection hook on the agents (split-brain test). Keep 0 outside tests.
# ALLOW_TEST_HOOKS=0

{
  "version": 1,
  "unit_id": 1,
  "word_order": "REAL and DINT span two registers, most significant word first (the order FORTE's Modbus layer uses).",
  "input_registers": [
    {"addr": 0,  "name": "RAW_LEVEL",   "type": "REAL", "unit": "m",    "desc": "Level sensor"},
    {"addr": 2,  "name": "FLOW",        "type": "REAL", "unit": "m3/h", "desc": "Discharge flow"},
    {"addr": 4,  "name": "FB_1",        "type": "UINT", "desc": "Pump 1 running feedback, 0/1"},
    {"addr": 5,  "name": "FB_2",        "type": "UINT", "desc": "Pump 2 running feedback, 0/1"},
    {"addr": 6,  "name": "TRIP_1",      "type": "UINT", "desc": "Pump 1 trip, 0/1"},
    {"addr": 7,  "name": "TRIP_2",      "type": "UINT", "desc": "Pump 2 trip, 0/1"},
    {"addr": 8,  "name": "AUTO_SWITCH", "type": "UINT", "desc": "Local panel AUTO switch, 0/1. Not writable from IT."},
    {"addr": 9,  "name": "HEARTBEAT",   "type": "UINT", "desc": "Increments every I/O tick while the I/O loop runs"},
    {"addr": 10, "name": "ACK_MIRROR",  "type": "UINT", "desc": "State of coil ACK, so one FC4 read carries all process inputs"},
    {"addr": 16, "name": "LEASE_EPOCH", "type": "UINT", "desc": "Fencing token of the current lease"},
    {"addr": 17, "name": "LEASE_HOLDER","type": "UINT", "desc": "Node id holding the lease, 0 = none"},
    {"addr": 18, "name": "LEASE_AGE_MS","type": "UINT", "desc": "ms since the last accepted control write, saturating at 65535"},
    {"addr": 19, "name": "WD_TRIPPED",  "type": "UINT", "desc": "1 = watchdog has forced outputs safe"},
    {"addr": 20, "name": "OUTPUT_1",    "type": "UINT", "desc": "Relay 1 state after fencing and watchdog"},
    {"addr": 21, "name": "OUTPUT_2",    "type": "UINT", "desc": "Relay 2 state after fencing and watchdog"},
    {"addr": 22, "name": "REJECTED",    "type": "UINT", "desc": "Control writes refused by fencing, wraps"},
    {"addr": 23, "name": "ACCEPTED",    "type": "UINT", "desc": "Control writes accepted, wraps"},
    {"addr": 24, "name": "WD_TRIPS",    "type": "UINT", "desc": "Watchdog trips since boot"},
    {"addr": 25, "name": "GRANTS",      "type": "UINT", "desc": "Leases granted since boot"},
    {"addr": 26, "name": "UPTIME_S",    "type": "UINT", "desc": "Seconds since boot, wraps"},
    {"addr": 27, "name": "MAP_VERSION", "type": "UINT", "desc": "Register map version"},
    {"addr": 28, "name": "WD_TIMEOUT_MS",  "type": "UINT", "desc": "Output watchdog timeout in force"},
    {"addr": 29, "name": "LEASE_TTL_MS",   "type": "UINT", "desc": "Lease time-to-live in force"},
    {"addr": 30, "name": "RESERVED_FOR",   "type": "UINT", "desc": "Node id a released lease is reserved for, 0 = none"}
  ],
  "coils": [
    {"addr": 0, "name": "ACK", "desc": "Alarm acknowledge. Set by FC5, cleared by the I/O after ack_pulse_ms."}
  ],
  "holding_registers": [
    {"addr": 90,  "name": "LEASE_REQ_NODE",    "type": "UINT", "group": "lease_request", "desc": "FC16 [node, expected_epoch]: compare-and-swap lease request"},
    {"addr": 91,  "name": "LEASE_REQ_EPOCH",   "type": "UINT", "group": "lease_request"},
    {"addr": 92,  "name": "LEASE_REL_NODE",    "type": "UINT", "group": "lease_release", "desc": "FC16 [node, epoch, reserved_for]: planned hand-over"},
    {"addr": 93,  "name": "LEASE_REL_EPOCH",   "type": "UINT", "group": "lease_release"},
    {"addr": 94,  "name": "LEASE_REL_NEXT",    "type": "UINT", "group": "lease_release"},
    {"addr": 100, "name": "STOP_LEVEL",  "type": "REAL", "unit": "m", "group": "setpoints", "default": 1.25, "min": 0.2, "max": 5.5},
    {"addr": 102, "name": "START_LEVEL", "type": "REAL", "unit": "m", "group": "setpoints", "default": 3.0,  "min": 0.2, "max": 5.5},
    {"addr": 104, "name": "LAG_LEVEL",   "type": "REAL", "unit": "m", "group": "setpoints", "default": 4.0,  "min": 0.2, "max": 5.5},
    {"addr": 106, "name": "HIGH_LEVEL",  "type": "REAL", "unit": "m", "group": "setpoints", "default": 5.0,  "min": 0.2, "max": 5.5},
    {"addr": 200, "name": "TOKEN",          "type": "UINT", "group": "control", "desc": "Fencing token. The whole block is refused unless this equals LEASE_EPOCH."},
    {"addr": 201, "name": "PUMP_1",         "type": "UINT", "group": "control"},
    {"addr": 202, "name": "PUMP_2",         "type": "UINT", "group": "control"},
    {"addr": 203, "name": "STATE_NO",       "type": "UINT", "group": "control"},
    {"addr": 204, "name": "LEAD_IS_2",      "type": "UINT", "group": "control"},
    {"addr": 205, "name": "HIGH_ALARM",     "type": "UINT", "group": "control"},
    {"addr": 206, "name": "STATION_FAULT",  "type": "UINT", "group": "control"},
    {"addr": 207, "name": "COMMS_OK",       "type": "UINT", "group": "control"},
    {"addr": 208, "name": "SENSOR_FAULT",   "type": "UINT", "group": "control"},
    {"addr": 209, "name": "FILTERED_LEVEL", "type": "REAL", "group": "control"},
    {"addr": 211, "name": "TOTAL",          "type": "REAL", "group": "control"},
    {"addr": 213, "name": "PULSES",         "type": "DINT", "group": "control"},
    {"addr": 215, "name": "STARTS",         "type": "UINT", "group": "control"},
    {"addr": 216, "name": "SCAN_COUNT",     "type": "UINT", "group": "control"},
    {"addr": 217, "name": "LAST_DT_10US",   "type": "UINT", "group": "control", "desc": "Last cycle time in 10 us units, 100 ms reads 10000"},
    {"addr": 218, "name": "MAX_DT_10US",    "type": "UINT", "group": "control", "desc": "Longest cycle time since this application started, 10 us units"},
    {"addr": 219, "name": "LAST_EXEC_US",   "type": "UINT", "group": "control"},
    {"addr": 230, "name": "CKPT_TOKEN",     "type": "UINT", "group": "checkpoint", "desc": "Fenced like TOKEN. Written by the agent, not by the scan."},
    {"addr": 231, "name": "CKPT_FAILED_1",  "type": "UINT", "group": "checkpoint"},
    {"addr": 232, "name": "CKPT_FAILED_2",  "type": "UINT", "group": "checkpoint"},
    {"addr": 233, "name": "CKPT_PENDING",   "type": "REAL", "group": "checkpoint"}
  ],
  "timing": {
    "wd_timeout_ms": 1000,
    "lease_ttl_ms": 300,
    "ack_pulse_ms": 500,
    "tick_ms": 20,
    "scan_ms": 100,
    "poll_ms": 50
  },
  "max_clients": 6,
  "field_io_esp32": {
    "relay_1_gpio": 26, "relay_2_gpio": 27, "fb_1_gpio": 32, "fb_2_gpio": 33,
    "trip_1_gpio": 25, "trip_2_gpio": 14, "auto_switch_gpio": 13, "level_adc_gpio": 34, "flow_adc_gpio": 35
  }
}
